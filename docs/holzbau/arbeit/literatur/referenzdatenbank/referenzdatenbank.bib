@techreport{wegener2024funktionswandel,
  author = {Wegener, Bernd A. and Fedkenheuer, Moritz L. and Drexler, Hans and Schupp, Laura},
  title = {Funktionswandel des Wohnens. Bestandsaufnahme der aktuellen Wohnpraxis mit dem Ziel der Projektion zuk\"unftigen Wohnbedarfs},
  year = {2024},
  institution = {Bundesinstitut f\"ur Bau-, Stadt- und Raumforschung (BBSR)},
  type = {BBSR-Online-Publikation 15/2024},
  address = {Bonn},
  doi = {10.58007/2s3m-6h29},
  url = {https://doi.org/10.58007/2s3m-6h29},
  note = {[V] verifiziert via BBSR-Veröffentlichungsseite (Autoren, DOI, 140 S.).},
  abstract = {Das Projekt hat eine Neubestimmung der Anforderungen und Bedürfnisse des Wohnens in Verbindung mit anderen Funktionen zum Ziel. Die aktuelle Wohnpraxis und Lebenssituation, sowie die Bedürfnisse der Menschen bilden die Grundlage für ein zukunftsfähiges Modell des Wohnens, Arbeitens und Lebens im 21. Jahrhundert. Die Coronakrise mit Lockdown und den Einschränkungen des öffentlichen und wirtschaftlichen Lebens hat deutlich gemacht, dass Wohnen einen neuen Stellenwert erhält. Nicht nur wird die im Zuge der Industrialisierung im 19. und 20. Jahrhundert entstandene Trennung von Arbeit und Familie in Frage gestellt, Wohnungen werden auch darüber hinaus zum Ort von Aktivitäten, die bis dahin räumlich getrennt abliefen. Während die sozialen und psychologischen Folgen dieser Entwicklung im Zentrum des wissenschaftlichen und politischen Interesses stehen, ist die Klärung der städtebaulichen, funktionalen und gebäudekundlichen Voraussetzungen bislang unbeachtet geblieben. Die Transformation des Alltagslebens und des Wohnens setzt nicht erst mit dem Ausbruch der weltweiten Krise ein. Vielmehr handelt es sich um eine Entwicklung, für die die Pandemie lediglich als Beschleuniger wirkt. Entsprechend ist das Projekt Reaktion auf einen nachhaltigen sozialen Wandel, der die Politik des zukünftigen Entwerfens und Bauens und der Stadtplanung nicht unberührt lassen darf. Im Zentrum des Projekts steht eine repräsentative Bevölkerungsbefragung in Deutschland zur Erfassung der zurückliegenden Krisenerfahrungen, Nutzungsprofile, Wohnpraktiken und Wohnwünsche in Bezug auf die Zukunft.},
  keywords = {Q434, FF2=2, FF6=3, Nutzung:übernehmen, Qualitaet:C, Kernbestand},
  annote = {Repräsentative BBSR-Befragung zu Wohnpraxis und Wohnbedürfnissen nach Corona: 84 % nutzen das Homeoffice, nur die Hälfte hält die Wohnung dafür geeignet (Rückzug, Platz, Lärm, Licht). Liefert direkt übernehmbare R5-Empfehlungen mit deutscher Datenbasis (FF6) und Kriterien für weiche Regeln (FF2). DataCite bestätigt BBSR-Online 15/2024, 140 S.},
}

@article{neumann2022homeoffice,
  author = {Neumann, Ute and Spellerberg, Annette and Eichholz, Lutz},
  title = {Ver\"anderungen beim Wohnen und von Standortpr\"aferenzen durch Homeoffice in der Covid-19-Pandemie?},
  year = {2022},
  journal = {Raumforschung und Raumordnung | Spatial Research and Planning},
  volume = {80},
  number = {4},
  pages = {434--450},
  doi = {10.14512/rur.133},
  url = {https://rur.oekom.de/index.php/rur/article/download/133/2033},
  note = {[V] verifiziert via Crossref.},
  abstract = {With the shift of the workplace to the private home in the Covid-19-pandemic, the sphere of gainful employment has more or less abruptly invaded the private sphere and has not only led to necessary adaptations in houses and flats, but has also raised new questions about the attractiveness of residential locations. Based on the results of an online survey, this paper examines the influence of home office on housing and settlement structures. Considerations of co-working spaces, another form of mobile work, are also included in the analyses. The aim of the paper is to contribute to the discussionabout the attractiveness of residential locations and the consequences of mobile working for housing behaviour. The results show: Contrary to what media discussions suggest, no clear effects on location preferences or a ‘new desire for thecountryside’ can be identified (so far). Furthermore, there is an increased willingness to move, especially in flats that are perceived as too small; dissatisfaction with the flat is higher among respondents with little space. Co-working Spaces donot yet play a role, but respondents with a preference for flexible forms of work are considering them.},
  keywords = {Q435, FF6=2, Nutzung:adaptieren, Qualitaet:B, Kernbestand},
  annote = {Abstract: Online-Befragung zeigt keine klare Verschiebung der Standortpräferenzen durch Homeoffice, aber höhere Umzugsbereitschaft und Unzufriedenheit bei als zu klein empfundenen Wohnungen. Begutachtete deutsche Studie, stützt die Empfehlung eines eigenen Arbeitsraums (FF6); Stichprobe regional.},
}

@techreport{eisele2024standards,
  author = {Eisele, Bj\"orn and Albus, Jutta},
  title = {Standards im Wohnungsbau als Kostenfaktor. Ausstattungsmerkmale als Entscheidungskriterium und einhergehende Zahlungsbereitschaft bei der Wohnungswahl},
  year = {2024},
  institution = {Bundesinstitut f\"ur Bau-, Stadt- und Raumforschung (BBSR)},
  type = {BBSR-Online-Publikation 86/2024},
  address = {Bonn},
  doi = {10.58007/jwz9-ze04},
  url = {https://doi.org/10.58007/jwz9-ze04},
  note = {[V] verifiziert via BBSR-Seite (Zitiervorschlag mit Initialen); korrigiert 2026-09-27: Vornamen ausgeschrieben},
  abstract = {Auf Basis einer repräsentativen Befragung unter 2.408 Mieterhaushalten wird ausgehend von der aktuellen Wohnsituation untersucht, welche Ausstattungsmerkmale die Wunschwohnung aufweisen sollte. In Kombination aus der Bedeutung von Ausstattungsmerkmalen und der dazugehörigen Zahlungsbereitschaft können die Ausstattungsmerkmale in vier Kategorien von Basis, Potenzial und Bonus bis Nische eingeordnet werden. Zudem identifiziert die Studie acht verschiedene Ausstattungstypen, die von Mieterinnen und Mietern bevorzugt werden. Die Untersuchung der Bedeutung von Klimaschutz- und Nachhaltigkeitsaspekten auf dem Wohnungsmarkt bildet einen weiteren wesentlichen Aspekt der Studie. Die Untersuchungsergebnisse zeigen hierbei eine vergleichsweise schlechte Ausstattung von deutschen Mietwohnungen an, was sich gleichermaßen in einer geringen Zufriedenheit mit den Heizkosten widerspiegelt. Die Gegenüberstellung von aktueller Wohnsituation und Wohnanforderungen offenbart darüber hinaus eine starke Diskrepanz zwischen den vorhandenen Ausstattungsmerkmalen, die Klimaschutz- und Nachhaltigkeitsaspekte betreffen und dem Interesse an diesen Standards. Viele Mieterinnen und Mieter wünschen sich diese Merkmale, aber nur wenige verfügen bereits darüber.},
  keywords = {Q436, FF2=1, FF6=2, Nutzung:adaptieren, Qualitaet:C, Peripherie},
  annote = {Abstract (DataCite): repräsentative Befragung von 2.408 Mieterhaushalten zu gewünschten Ausstattungsmerkmalen und Zahlungsbereitschaft; Raster für Bemusterungs-Voreinstellungen und Mehrpreise (FF6). Mieter statt Bauherren, daher nur mit Anpassung. Vornamen laut DataCite: Björn Eisele, Jutta Albus; BBSR-Online 86/2024.},
}

@techreport{ammann2022wohneigentum,
  author = {Ammann, Iris and M\"uther, Anna Maria},
  title = {Wohneigentumsbildung und Wohnfl\"achenverbrauch. Bestandsaufnahme und zuk\"unftige Entwicklung},
  year = {2022},
  institution = {Bundesinstitut f\"ur Bau-, Stadt- und Raumforschung (BBSR)},
  type = {BBSR-Analysen KOMPAKT 14/2022},
  address = {Bonn},
  doi = {10.58007/cqa5-jm26},
  url = {https://doi.org/10.58007/cqa5-jm26},
  note = {[V] verifiziert via BBSR-Seite; korrigiert 2026-09-27: Vorname Müther ausgeschrieben},
  abstract = {Viele Haushalte wünschen sich weiterhin selbstgenutztes Wohneigentum. Insbesondere das Einfamilienhaus wird in diesem Zusammenhang besonders nachgefragt, auch wenn der Großteil der Wohneigentumsbildung im Bestand realisiert wird. Dies bestätigt auch die aktuelle Befragung zur Wohneigentumsbildung. Gleichzeitig wird in der Gesellschaft und der Politik die Inanspruchnahme von Ressourcen kritisch diskutiert und auf den ersten Blick scheinen Nutzungskonflikte zu bestehen. Wohneigentum findet sich somit im Spannungsfeld zwischen Wohnwünschen, bezahlbaren Wohnen und Nachhaltigkeit wider. Die aktuelle Nachfrage und die Wohnwünsche sind eine Facette der Gesamtbetrachtung und werden in diesem BBSR-Analysen KOMPAKT mit der zukünftigen Entwicklung der Wohnflächeninanspruchnahme, Eigentümerquote und Haushaltsentwicklungen in Zusammenhang gebracht. So bleibt nach den Trendanalysen des BBSR die Wohnflächeninanspruchnahme auch zukünftig hoch. Die Befragungsergebnisse und Prognosen des BBSR zeigen, dass die Zusammenhänge sehr viel komplexer sind und Aspekte wie die Singularisierung und Alterung der Gesellschaft eine wichtige Rolle spielen. So zeigt sich, dass veränderte Haushaltsstrukturen die Inanspruchnahme der Wohnfläche am stärksten beeinflussen und der steigende Wohnflächenverbrauch vor allem durch die Zunahme kleinerer Haushalte entsteht.},
  keywords = {Q437, FF6=1, Nutzung:Kontext, Qualitaet:C, Peripherie},
  annote = {Abstract (DataCite): Wunsch nach Wohneigentum, besonders Einfamilienhaus, und Wohnflächennachfrage; nur Marktkontext (FF6 am Rand). Vorname Müther laut DataCite: Anna Maria; BBSR-Analysen KOMPAKT 14/2022.},
}

@techreport{ammann2023faktencheck,
  author = {Ammann, Iris},
  title = {Wohneigentumsbildung -- Faktencheck 2.0. Ergebnisse der Befragung zur Wohneigentumsbildung in Deutschland 2018 bis 2021},
  year = {2023},
  institution = {Bundesinstitut f\"ur Bau-, Stadt- und Raumforschung (BBSR)},
  type = {BBSR-Analysen KOMPAKT 08/2023},
  address = {Bonn},
  doi = {10.58007/cyqq-1a27},
  url = {https://doi.org/10.58007/cyqq-1a27},
  note = {[V] verifiziert via BBSR-Seite; Kennzahlen via BBSR-Topmeldung 28.11.2022.},
  abstract = {Der Wunsch nach einer eigenen Immobilie ist bei vielen Menschen trotz oder gerade aufgrund von Krisenzeiten weiterhin hoch. Wohneigentum bietet in unsicheren Zeiten Sicherheit, sei es finanzielle als auch emotionale. Die aktuelle Befragung zur Wohneigentumsbildung der Jahre 2018 bis 2021, fällt in die Hochphase der COVID-19-Pandemie und untersucht damit auch das Verhalten von Wohneigentumsbildenden in Zeiten weltweiter Krisen. Sie beruht auf den Ergebnissen der Befragung des Marktforschungsinstituts Kantar im Auftrag Bundesinstituts für Bau-, Stadt und Raumforschung (BBSR). Die Folgen der Pandemie sind auch bei der Wohneigentumsbildung spürbar, jedoch wirken sich die einschneiden Ereignisse sehr unterschiedlich auf die verschiedenen Aspekte des Immobilienerwerbs aus. So wurde der Wunsch nach finanzieller Absicherung durch eigene Immobilien bei vielen Menschen verstärkt, dagegen waren die Auswirkungen auf die Immobilienfinanzierung überraschend gering. Dagegen veränderten sich Trends im Hinblick auf den Wohnstandort sowie das Wohnverhalten in dieser Zeit deutlicher. Die gestiegenen Immobilienpreise führten bereits vor der Pandemie zu Wanderungsbewegungen in günstigere Regionen. Diese Entwicklung hat sich weiter verstärkt. Die Studie zeigt darüber hinaus, dass vor allem für die unteren Einkommensgruppen die Wohneigentumsbildung zunehmend schwieriger wird. Gerade für diese Haushalte spielen geerbte bzw. geschenkte Immobilien eine immer wichtigere Rolle, um überhaupt an eigene Immobilien zu gelangen.},
  keywords = {Q438, FF6=1, Nutzung:Kontext, Qualitaet:C, Peripherie},
  annote = {Abstract (DataCite): Befragung zur Wohneigentumsbildung 2018–2021 in der Pandemie; Marktkontext Zielgruppe Familie und freistehendes EFH (FF6 am Rand). BBSR-Analysen KOMPAKT 08/2023, ISBN 978-3-98655-077-6.},
}

