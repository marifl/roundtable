@inproceedings{aichholzer1996general,
  author = {Aichholzer, Oswin and Aurenhammer, Franz},
  title = {Straight skeletons for general polygonal figures in the plane},
  year = {1996},
  booktitle = {Computing and Combinatorics},
  pages = {117--126},
  publisher = {Springer Berlin Heidelberg},
  doi = {10.1007/3-540-61332-3_144},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403) und Crossref-Record (Exa-Fetch); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von kelly2011interactive, rückwärts.},
  abstract = {A novel type of skeleton for general polygonal figures, the straight skeleton of a planar straight line graph , is introduced and discussed. Exact bounds on the size of are derived. The straight line structure of and its lower combinatorial complexity may make preferable to the widely used Voronoi diagram (or medial axis) of in several applications. We explain why has no Voronoi diagram based interpretation and why standard construction techniques fail to work. A simple space algorithm for constructing is proposed. The worst-case running time is , but the algorithm can be expected to be practically efficient, and it is easy to implement. We also show that the concept of is flexible enough to allow an individual weighting of the edges and vertices of , without changes in the maximal size of , or in the method of construction. Apart from offering an alternative to Voronoi-type skeletons, these generalizations of have applications to the reconstruction of a geographical terrain from a given river map, and to the construction of a polygonal roof above a given layout of ground walls.},
  keywords = {Q736, FF6=2, Nutzung:Kontext, Qualitaet:B, Kernbestand},
  annote = {(ohne Abstract) Erweiterung des Straight Skeleton auf allgemeine polygonale Figuren (mit Löchern); theoretische Grundlage für Dächer über Grundrissen mit Innenhof (FF6). Durch Implementierungen (eder2021exact) für die Praxis abgelöst. COCOON 1996, LNCS 1090, S. 117–126.},
}

@article{ali2013critiquing,
  author = {Ali, Norhayati Mohd and Hosking, John and Grundy, John},
