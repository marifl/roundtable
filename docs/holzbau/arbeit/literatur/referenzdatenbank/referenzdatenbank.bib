@article{appolloni2021housing,
  author = {Appolloni, Letizia and D’Alessandro, Daniela},
  title = {Housing Spaces in Nine European Countries: A Comparison of Dimensional Requirements},
  year = {2021},
  journal = {International Journal of Environmental Research and Public Health},
  volume = {18},
  number = {8},
  pages = {4278},
  doi = {10.3390/ijerph18084278},
  url = {https://www.mdpi.com/1660-4601/18/8/4278/pdf},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von hanson1998decoding, vorwärts.},
  abstract = {Modern housing units must meet new needs and requirements; housing dimensions and functional characteristics are relevant issues, mainly considering population ageing and disability. The housing standards of nine European countries were compared to analyze their ability to satisfy new population need, in terms of size. The regulations were downloaded from the websites of the official channels of each country. A wide variability in room size was observed (e.g., single room: from 9 m2 in Italy to 7 m2 in France, to the absence of any limit in England and Wales, Germany-Hesse, and Denmark). Italian and French legislations define housing dimension considering the room destination and the number of people. The Swedish regulation provides performance requirements and functional indications but does not specify the minimum dimensions of habitable rooms. The rooms’ minimum heights vary between 2.70 m in Italy and Portugal and 2.60 m in the Netherlands, but no limits are established in England and Wales. A diverse approach among European countries regulations is observed: from a market-oriented logic one (e.g., England and Wales) in which room minimum dimensions are not defined to a prescriptive one (Italy) and one that is functionality-oriented (the Netherlands). However, considering the health, social, environmental, and economic trends, many of these standards should be revised.},
  keywords = {Q741, FF2=1, FF6=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: Mindestmaße für Wohnräume in neun europäischen Ländern im Vergleich, etwa Einzelzimmer 7–9 m², Raumhöhe 2,60–2,70 m, für Deutschland nur Hessen betrachtet und ohne Grenzwert. Kontext für Raumgrößen-Empfehlungen (FF6) und Mindestanforderungen (FF2); BayBO-Werte sind eigens zu belegen.},
}

@article{asare2026dimensionality,
  author = {Asare, Kofi A. B. and Liu, Rui and Anumba, Chimay J.},
  title = {Dimensionality of BIM LODs in the Digital Twin Continuum},
  year = {2026},
  journal = {Journal of Computing in Civil Engineering},
  volume = {40},
  number = {1},
  pages = {04025112},
  doi = {10.1061/jccee5.cpeng-6479},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2025. Schneeball von abualdenien2022levels, vorwärts.; korrigiert 2026-09-27: Artikelnummer 04025112 ergänzt (Crossref article-number)},
  abstract = {Building information modeling (BIM) plays a foundational role in the implementation of digital twins (DTs) in the architecture, engineering, construction, and operations (AECO) industry. However, there remains a lack of clarity over how varying BIM levels of development (LODs) align to the DTs digital model developed from BIM models, especially from a data maturity and DT application perspective. This research presents a pioneering effort to align the BIM LODs to the different classes of DTs. The dimensionality of BIM data, i.e., the evolving number of model features and attributes as the model progresses, is mapped onto the different classes of DTs, leading to the definition of a novel taxonomy for classifying BIM-based DTs. The ensuing taxonomy, validated by stakeholders in industry and academia, helps clarify the utility of as-designed and as-built models in the implementation of BIM-based DTs in the AECO industry. Ultimately, the research clarifies how LOD 500 relates to BIM-based DTs for facilities management (FM) from an element modeling perspective. This research provides a theoretical foundation for future DT researchers on how to classify their BIM-based DTs for FM and practical guidance for owners on what the LOD requirements are for different types of DTs for FM.},
  keywords = {Q742, FF6=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: Taxonomie ordnet BIM-LODs Klassen digitaler Zwillinge für das Facility Management zu, von Fachleuten validiert. Nur Kontext für Übergabe und LOD 500 (FF6); jenseits des Planungsumfangs. JCCE 40(1), 2026 (online 2025); Artikelnummer im Record fehlt.},
}

