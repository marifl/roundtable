@article{park2026bimllm,
  author = {Park, Ingeon and Kim, Yije and Kim, Kyoungmin and Chin, Sangyoon},
  title = {BIM–LLM integration in AECO workflows: Applications, validation, and future directions},
  year = {2026},
  journal = {Automation in Construction},
  volume = {187},
  pages = {106905},
  doi = {10.1016/j.autcon.2026.106905},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract über Verlags-/Repositoriumsseite (Exa) gelesen. Schneeball von du2026text2bim, vorwärts.},
  abstract = {This review synthesizes 61 studies to examine how Building Information Modeling (BIM) and Large Language Models (LLMs) are integrated across architecture, engineering, construction, and operation workflows. A systematic review methodology combining bibliometric analysis, BERTopic-based topic modeling, and application-level evaluation was employed. The review identified six primary applications: information retrieval, data modeling, compliance checking, performance optimization, construction information interaction, and knowledge modeling. Information retrieval was the most prevalent (29.5%), and applications were concentrated in the design (35.1%) and construction (34.0%) phases of the project lifecycle. Analysis of research validation status revealed moderate technical validation (70.5%) but relatively low industrial validation (44.3%), indicating that many studies remain at an early stage of real-world deployment. Additionally, 40.0% of studies aligned with traditional BIM Uses, while also indicating opportunities to expand BIM toward knowledge-based reasoning and language-driven interaction. This review provides a structured analytical framework and highlights future research directions to support scalable and industry-ready BIM-LLM integration.},
  keywords = {Q655, FF3=2, FF5=1, Nutzung:Kontext, Qualitaet:A, Kernbestand},
  annote = {Abstract (Repositorium SKKU): Systematisches Review von 61 BIM-LLM-Studien mit sechs Anwendungsfeldern; Informationsabfrage dominiert (29,5 %), technische Validierung 70,5 %, industrielle nur 44,3 %. Stützt FF3 als Stand der Forschung und die Forschungslücke (5.8), dass Sprach-BIM-Kopplungen selten im Betrieb erprobt sind (FF5).},
}

@article{ratul2026handdrawn,
  author = {Ratul, Abir Khan and Acharjee, Sanjay and Park, Somin and Sakib, Md Nazmus},
  title = {Multi-agent human-AI collaborative framework for converting hand-drawn floor plans to 3D BIM},
  year = {2026},
  journal = {Automation in Construction},
  volume = {189},
  pages = {106984},
  doi = {10.1016/j.autcon.2026.106984},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von du2026text2bim, vorwärts.},
  abstract = {This study introduces a human-in-the-loop pipeline that converts unscaled, hand-drawn floor plan sketches into semantically consistent 3D BIM models. The workflow leverages multimodal large language models (MLLMs) within a multi-agent framework, combining perceptual extraction, human feedback, schema validation, and automated BIM scripting. Initially, sketches are iteratively refined into a structured JSON layout of walls, doors, and windows. Later, these layouts are transformed into executable scripts that generate 3D BIM models. Experiments on ten diverse floor plans demonstrate strong convergence: openings (doors, windows) are captured with high reliability in the initial pass, while wall detection begins around 83% and achieves near-perfect alignment after a few feedback iterations. Across all categories, precision, recall, and F1 scores remain above 0.83, and geometric errors (RMSE, MAE) progressively decrease to zero through feedback corrections. This study demonstrates how MLLM-driven multi-agent reasoning can make BIM creation accessible to both experts and non-experts using only freehand sketches.},
  keywords = {Q656, FF1=1, FF3=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract aus der arXiv-Vorfassung 2510.20838 (Sketch2BIM), Journalfassung nur bibliografisch geprüft: Multimodale LLM-Agenten überführen Handskizzen über ein schemavalidiertes JSON-Layout und menschliche Rückmeldung in BIM-Skripte; F1 über 0,83, geometrische Fehler nach Korrekturschleifen null. Stützt FF3 mit typisierter Zwischenrepräsentation und Rückfrageschleife, auch für Laien; FF1 am Rand.},
}

@inproceedings{schick2023toolformer,
  author = {Schick, Timo and Dwivedi-Yu, Jane and Dessì, Roberto and Raileanu, Roberta and Lomeli, Maria and Hambro, Eric and Zettlemoyer, Luke and Cancedda, Nicola and Scialom, Thomas},
  title = {Toolformer: Language Models Can Teach Themselves to Use Tools},
  year = {2023},
  booktitle = {Advances in Neural Information Processing Systems 36},
  pages = {68539--68551},
  publisher = {Neural Information Processing Systems Foundation, Inc. (NeurIPS)},
  doi = {10.52202/075280-2997},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403) und Crossref-Record (Exa-Fetch); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von kodnongbua2024zeroshot, rückwärts.},
  abstract = {Language models (LMs) exhibit remarkable abilities to solve new tasks from just a few examples or textual instructions, especially at scale. They also, paradoxically, struggle with basic functionality, such as arithmetic or factual lookup, where much simpler and smaller specialized models excel. In this paper, we show that LMs can teach themselves to use external tools via simple APIs and achieve the best of both worlds. We introduce Toolformer, a model trained to decide which APIs to call, when to call them, what arguments to pass, and how to best incorporate the results into future token prediction. This is done in a self-supervised way, requiring nothing more than a handful of demonstrations for each API. We incorporate a range of tools, including a calculator, a Q&A system, a search engine, a translation system, and a calendar. Toolformer achieves substantially improved zero-shot performance across a variety of downstream tasks, often competitive with much larger models, without sacrificing its core language modeling abilities.},
  keywords = {Q657, FF3=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {(ohne Abstract) Toolformer: Ein Sprachmodell lernt selbstüberwacht, externe Werkzeuge (Rechner, Suche) per API aufzurufen (NeurIPS 36). Allgemeiner Hintergrund zur Werkzeugaufruf-Architektur (FF3); die Arbeit nutzt eine feste Intent-Menge statt gelernter Aufrufe.},
}

@article{wang2021knowledge,
  author = {Wang, Yue and Li, Xiang and Mo, Daniel},
  title = {Knowledge-Empowered Multitask Learning to Address the Semantic Gap Between Customer Needs and Design Specifications},
  year = {2021},
  journal = {IEEE Transactions on Industrial Informatics},
  volume = {17},
  number = {12},
  pages = {8397--8405},
  doi = {10.1109/tii.2021.3067141},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von randall2007user, vorwärts.},
  abstract = {Smart manufacturing attempts to build a collaborative and integrated platform to enable flexibility in product design and manufacturing processes so as to better address customer needs. This makes a smooth information flow a prerequisite for smart manufacturing. However, firms usually struggle with a lack of consistency and coherence in communication and information exchange in design and manufacturing practices, a phenomenon called “semantic gap.” This article presents a multitask learning framework to close the semantic gap between customers and designers/engineers to facilitate efficient product codevelopment. We elicited domain knowledge from a product review text corpus and integrated the knowledge into a bidirectional long short-term memory-based multitask learning network. Transfer learning was then applied to adapt the network so it could bridge the semantic gap between customer needs and product specifications. Experiment results indicate that the proposed method unites customer needs and product specifications in smart manufacturing by effectively mapping across these domains.},
  keywords = {Q658, FF3=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: Multitask-Lernen (BiLSTM) mit aus Produktbewertungen gewonnenem Domänenwissen und Transfer Learning bildet Kundenbedürfnisse auf Konstruktionsspezifikationen ab. Nur Kontext für FF3; Konsumgüter und Bewertungstexte, kein Dialog und keine Regeln.},
}

@article{wang2021needsbased,
  author = {Wang, Yue and Zhao, Wenlong and Wan, Wayne Xinwei},
  title = {Needs-Based Product Configurator Design for Mass Customization Using Hierarchical Attention Network},
  year = {2021},
  journal = {IEEE Transactions on Automation Science and Engineering},
  volume = {18},
  number = {1},
  pages = {195--204},
  doi = {10.1109/tase.2019.2957136},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2020. Schneeball von randall2007user, vorwärts.},
  abstract = {Mass customization aims to provide goods and services that meet each individual customer's needs with a level of efficiency close to that of mass production. It is also a viable smart manufacturing strategy for companies that want to gain a competitive advantage in the current business environment. Product configurators are one of the major toolkits enabling mass customization. Existing product configurators require customers to choose from a set of predefined attributes or a list of component alternatives. However, customers may feel confused when configuring products if they do not have the necessary domain knowledge about the product. This article proposes a needs-based configurator mechanism that takes customer needs expressed in natural language as input to generate satisfactory product variants as output. This method leverages online product review data to distill the knowledge of customer preferences and needs, which then maps onto the product attribute specifications. A hierarchical attention network is applied to fully extract the information in the review text, which emphasizes the important keywords and phrases. We have obtained the promising experimental results, and our proposed needs-based configurators could help customers to find satisfactory product configurations with high recall rates.},
  keywords = {Q659, FF3=2, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract: Bedarfsbasierter Konfigurator: Ein hierarchisches Attention-Netz leitet aus natürlichsprachlich geäußerten Bedürfnissen Produktattributwerte ab (hoher Recall). Stützt FF3 (Intent-Erkennung statt Parameterabfrage, vgl. Randall et al. 2007) und am Rand die Bemusterung (FF6); Laptops, trainiert auf Bewertungstexten. Online 2019/2020, Heftjahrgang 2021.},
}

@article{wang2022natural,
  author = {Wang, Yue and Li, Xiang and Zhang, Linda L. and Mo, Daniel},
  title = {Configuring products with natural language: a simple yet effective approach based on text embeddings and multilayer perceptron},
  year = {2022},
  journal = {International Journal of Production Research},
  volume = {60},
  number = {17},
  pages = {5394--5406},
  doi = {10.1080/00207543.2021.1957508},
  url = {https://doi.org/10.1080/00207543.2021.1957508},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2021. Schneeball von trentin2013sales, vorwärts; Schneeball von randall2007user, vorwärts.},
  abstract = {Product configurators are recognised as critical toolkits enabling customers to co-create products with companies. Most available product configurators require customers to select suitable product attributes from predefined options. However, customers usually find the selection processes frustrating due to their lack of product knowledge. In view of the fact that customers often express their needs in imprecise and vague natural language, we define a new needs-based configuration mechanism and propose an implementation approach based on text embeddings and multilayer perceptron. Specifically, we leverage the massive amount of product reviews by encoding them into text embeddings. A multilayer perceptron is trained to map text embeddings to product attribute options. Experiment results indicate that the mapping has good generalisation capability to map customer needs into product configurations. The performance of our approach is comparable to that of deep learning-based approaches but with much higher efficiency in terms of computational complexity. Our needs-based configuration thus provides a quick and effective means of facilitating product customisation. It also demonstrates an innovative way of utilising customer resources in unstructured text to co-create products with companies.},
  keywords = {Q660, FF3=3, FF6=1, Nutzung:adaptieren, Qualitaet:B, Kernbestand},
  annote = {Abstract: Text-Embeddings plus mehrschichtiges Perzeptron bilden vage Bedarfsbeschreibungen auf Konfiguratorattribute ab, genauso gut wie Deep-Learning-Ansätze, aber mit viel geringerem Rechenaufwand. Übernehmbares Muster für das lokale Intent-Modell (FF3): leichter Klassifikator mit Wahrscheinlichkeiten über festen Optionen; Konsumgüter, keine deutschen Texte.},
}

@article{wu2019retrieval,
  author = {Wu, Songfei and Shen, Qiyu and Deng, Yichuan and Cheng, Jack},
  title = {Natural-language-based intelligent retrieval engine for BIM object database},
  year = {2019},
  journal = {Computers in Industry},
  volume = {108},
  pages = {73--88},
  doi = {10.1016/j.compind.2019.02.016},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von kodnongbua2024zeroshot, rückwärts.},
  abstract = {Rapid growth of building components in the BIM object database increases the difficulty of the efficient query of components that users require. Retrieval technology such as Autodesk Seek in America and BIMobject in Europe, which are widely used in BIM databases, are unable to understand what the search field truly means, causing a lack of completion and a low accuracy rate for results incapable of meeting the demands of users. To tackle such a problem, this paper puts forward a natural-language-based intelligent retrieval engine for the BIM object database and Revit modeling. First, a domain ontology is constructed for semantic understanding, and the BIM object database framework is established for testing our search engine. Second, “target keyword” and “restriction sequence” proposed are extracted from the natural sentences of users. Then, a final query is formed, combining concepts of “keyword” and “restriction sequence”, and its concepts are expanded through the semantic relationship in ontology. Finally, the results are presented after mapping from the final query to the BIM object database and ranking of results. Compared with traditional keyword-based methods, the experimental results demonstrate that our method outperforms the traditional methods.},
  keywords = {Q661, FF1=1, FF3=2, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract (Verlagsseite): Suchmaschine für eine IFC-basierte BIM-Objektdatenbank; Ontologie auf IFD-Basis und NLP extrahieren Zielbegriff und Einschränkungen aus Nutzersätzen und erweitern sie semantisch, besser als Stichwortsuche (F-Maß 0,28). Stützt den Match-Schritt Begriff → Katalogartikel (FF3) und die Suchbarkeit der Bemusterung (FF6); chinesischer Kontext, schwache absolute Werte.},
}

@article{wu2026alterations,
  author = {Wu, Jiabin and Fuchs, Stefan and Pauwels, Pieter and Borrmann, André},
  title = {Automated building component alterations driven by LLM-formalized human strategies to achieve code compliance},
  year = {2026},
  journal = {Automation in Construction},
  volume = {190},
  pages = {107148},
  doi = {10.1016/j.autcon.2026.107148},
  url = {https://doi.org/10.1016/j.autcon.2026.107148},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von du2026text2bim, vorwärts.},
  abstract = {Ensuring code compliance remains a critical challenge in building design, particularly when navigating interdependent requirements. While Automated Compliance Checking (ACC) systems identify violations, they offer limited guidance for issue resolution, leaving post-checking design adaptation as a laborious process. To support the search for feasible design solutions, this paper proposes an approach that automates component-level alterations toward compliant alternatives. This approach leverages Large Language Models (LLMs) to formalize human-authored improvement strategies into building component operations, ensuring that the alteration scope remains governed by designer input. Topologically related components associated with the violations are queried to instantiate executable alterations. The method is demonstrated through a case study focusing on International Building Code (IBC) spatial requirements. The approach identifies feasible alterations and resolution clusters to support code-compliant design exploration across interdependent compliance issues. With its potential to resolve cross-system computational challenges, this framework offers a foundation for more integrated design-authoring and compliance-checking workflows.},
  keywords = {Q662, FF2=2, FF3=3, Nutzung:adaptieren, Qualitaet:B, Kernbestand},
  annote = {Abstract: Ein Sprachmodell formalisiert von Menschen formulierte Verbesserungsstrategien in Bauteiloperationen; topologische Abfragen erzeugen daraus ausführbare, regelkonforme Änderungen, deren Umfang der Entwerfer vorgibt (IBC-Raumregeln). Übernehmbarer Baustein für FF3 (Sprachmodell formalisiert, deterministischer Code ändert) und Stütze für Alternativen in 9.5 (FF2); keine Laien, kein Holzbau.},
}

@article{yin2023ontology,
  author = {Yin, Mengtian and Tang, Llewellyn and Webster, Chris and Xu, Shen and Li, Xiongyi and Ying, Huaquan},
  title = {An ontology-aided, natural language-based approach for multi-constraint BIM model querying},
  year = {2023},
  journal = {Journal of Building Engineering},
  volume = {76},
  pages = {107066},
  doi = {10.1016/j.jobe.2023.107066},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von elsibaii2025open, rückwärts.},
  abstract = {Being able to efficiently retrieve the required building information is critical for construction project stakeholders to carry out their engineering and management activities. Natural language interface (NLI) systems are emerging as a time and cost-effective way to query Building Information Models (BIMs). However, the existing methods cannot logically combine different constraints to perform fine-grained queries, dampening the usability of natural language (NL)-based BIM queries. This paper presents a novel ontology-aided semantic parser to automatically map natural language queries (NLQs) that contain different attribute and relational constraints into computer-readable codes for querying complex BIM models. First, a modular ontology was developed to represent NL expressions of Industry Foundation Classes (IFC) concepts and relationships, and was then populated with entities from target BIM models to assimilate project-specific information. Hereafter, the ontology-aided semantic parser progressively extracts concepts, relationships, and value restrictions from NLQs to fully identify constraint conditions, resulting in standard SPARQL queries with reasoning rules to successfully retrieve IFC-based BIM models. The approach was evaluated based on 225 NLQs collected from BIM users, with a 91% accuracy rate. Finally, a case study about the design-checking of a real-world residential building demonstrates the practical value of the proposed approach in the construction industry.},
  keywords = {Q663, FF1=1, FF2=1, FF3=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract aus der arXiv-Vorfassung 2303.15116: Ontologiegestützter semantischer Parser übersetzt natürlichsprachliche Abfragen mit Attribut- und Relationsbedingungen in SPARQL über IFC-Modelle; 91 % Genauigkeit an 225 Nutzerfragen, Fallstudie zur Entwurfsprüfung eines Wohngebäudes. Stützt FF3 (explizite Semantik für deterministische Übersetzung), am Rand FF1 und FF2; Abfrage, keine Änderung.},
}

@article{zhang2026multiagent,
  author = {Zhang, Haolan and Zhang, Ruichuan},
  title = {A Multiagent Large Language Model–Based System for Early-Stage Building Layout Planning},
  year = {2026},
  journal = {Journal of Computing in Civil Engineering},
  volume = {40},
  number = {6},
  doi = {10.1061/jccee5.cpeng-7723},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von du2026text2bim, vorwärts.},
  abstract = {This paper proposes a multiagent large language model (LLM)–based system for early-stage building layout planning, which enables flexible design requirement inputs and robust spatial reasoning. Existing generative methods often depend on structured inputs, and perform poorly when faced with incomplete requirements or regulatory constraints. Moreover, although LLMs excel at understanding language, they typically lack the spatial reasoning capabilities required for layout generation. To address these limitations, the proposed system includes five core modules: a requirement interpreter that standardizes design requirements and employs multimodal retrieval-augmented generation (RAG) to fetch similar layouts; a planner module composed of specialized LLM agents such as an architect, accessibility expert, and user experience advocate; a layout executor that transforms planning strategies into bubble diagrams; and an evaluation module that combines rule-based checks and LLM-based feedback. All modules are coordinated by a director module using multichain-of-thought reasoning to iteratively refine the design process. The system supports natural language prompts, layout boundaries, and optional reference layouts, making it suitable for both incomplete and detailed design scenarios. After a bubble diagram is finalized, a diffusion-based generative model produces a complete architectural layout. Experimental results using the Tell2Design data set demonstrated significant improvements in both geometric quality and semantic alignment over a baseline LLM-only system. Case studies of office and multiapartment buildings further validated the system’s adaptability and effectiveness in complex design contexts.},
  keywords = {Q664, FF2=1, FF3=2, FF6=1, Nutzung:abgrenzen, Qualitaet:B, Peripherie},
  annote = {Abstract: Multiagenten-LLM für frühe Grundrissplanung (Anforderungsinterpret mit RAG, Rollenagenten, Bubble-Diagramm, Regel- und LLM-Bewertung), Grundriss danach per Diffusionsmodell; besser als eine reine LLM-Baseline auf Tell2Design. Vergleichsarbeit für FF3, von der sich die Arbeit abgrenzt (generiert statt deterministisch abgeleitet); FF2 und FF6 am Rand.},
}

@article{attia2024usability,
  author = {Attia, Shady and El-Degwy, Aly and Attia, Maha},
  title = {Usability and fitness testing for building performance simulation tools},
  year = {2024},
  journal = {Journal of Building Performance Simulation},
  volume = {17},
  number = {4},
  pages = {460--479},
  doi = {10.1080/19401493.2024.2341089},
  url = {https://orbi.uliege.be/bitstream/2268/316181/1/Usability%20and%20fitness%20testing%20for%20building%20performance%20simulation%20tools%20%281%29.pdf},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von prat2015taxonomy, vorwärts.},
  abstract = {Architects and engineers who seek design decision aid for sustainable building and city design frequently experience decisional conflict and require support across the design process. Building performance simulations have become central to supporting the design process, but little is known about the fit and usability of simulation tools and the factors influencing the implementation of simulation-based design in practice. This paper presents a novel framework for simulation tool usability called USER-FIT. The framework defines usability based on ISO definitions, a review of evidence in the literature, and our experience supporting the development of the framework. USER-FIT provides six measures for modelers and software developers to test how a simulation tool is useful, usable, and satisfactory for the intended users to inform sustainable design decision-making. Further research and testing are needed to support better the acquisition and implantation of usability testing for building performance simulation tools and applications.},
  keywords = {Q665, FF5=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract: USER-FIT definiert auf ISO-Basis sechs Maße, mit denen Nützlichkeit, Usability und Zufriedenheit von Gebäudesimulationswerkzeugen für Architekten und Ingenieure geprüft werden. Stützt FF5 als Evaluationsrahmen für die Expertenseite im Bauwesen; nicht an Laien validiert.},
}

@article{bakhshi2021dfma,
  author = {Bakhshi, Sajjad and Chenaghlou, Mohammad Reza and Pour Rahimian, Farzad and Edwards, David J. and Dawood, Nashwan},
  title = {Integrated BIM and DfMA parametric and algorithmic design based collaboration for supporting client engagement within offsite construction},
  year = {2022},
  journal = {Automation in Construction},
  volume = {133},
  pages = {104015},
  doi = {10.1016/j.autcon.2021.104015},
  url = {https://research.tees.ac.uk/en/publications/a5f951f2-aba8-48f5-8b61-3f7593ef3327},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract über Verlags-/Repositoriumsseite (Exa) gelesen. Schneeball von schoenwitz2017product, vorwärts.; korrigiert 2026-09-27: Jahr 2021 (online) -> 2022 (AutCon 133, published-print 01/2022); Key unverändert},
  abstract = {As a proactive reaction to current ineffective collaboration strategies, this study sought to combine the capabilities of Building Information Modelling (BIM) in the Design for Manufacturing and Assembly (DfMA) method with mass customisation into a framework that enables customers to participate in the offsite construction configuration process. This approach engenders greater customer satisfaction whilst increasing production and construction efficiency. A model capable of facilitating the use of construction information in the proposed framework was developed to implement the proposed framework into practice. Combining the BIM model within the framework provides all project stakeholders with prerequisite information needed for a building's configuration. This collaborative process utilises an algorithmic composition in which the current assembly information in both the BIM model and framework is used as a controlling factor in the configuration process. The parametric environment of Revit and the algorithmic environment of the Dynamo plugin were used to realise the proposed framework (as a proof of concept).},
  keywords = {Q666, FF1=2, FF2=2, FF5=1, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract (Repositorium Teesside): Rahmen aus BIM, DfMA und Mass Customisation, in dem Kunden die Offsite-Konfiguration mitgestalten; Montageinformation im BIM steuert die algorithmische Konfiguration (Revit/Dynamo, Proof of Concept). Nächstverwandter Vergleichsansatz zum Zielbild für FF1 und FF2; keine gemessene Wirkung, proprietär. Bibliografie: Heftjahrgang 2022 (AutCon 133), Master nennt 2021 (online).},
}

@article{borsci2022chatbot,
  author = {Borsci, Simone and Malizia, Alessio and Schmettow, Martin and van der Velde, Frank and Tariverdiyeva, Gunay and Balaji, Divyaa and Chamberlain, Alan},
  title = {The Chatbot Usability Scale: the Design and Pilot of a Usability Scale for Interaction with AI-Based Conversational Agents},
  year = {2022},
  journal = {Personal and Ubiquitous Computing},
  volume = {26},
  number = {1},
  pages = {95--119},
  doi = {10.1007/s00779-021-01582-9},
  url = {https://link.springer.com/content/pdf/10.1007/s00779-021-01582-9.pdf},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2021. Schneeball von brooke1996sus, vorwärts.},
  abstract = {Standardised tools to assess a user’s satisfaction with the experience of using chatbots and conversational agents are currently unavailable. This work describes four studies, including a systematic literature review, with an overall sample of 141 participants in the survey (experts and novices), focus group sessions and testing of chatbots to (i) define attributes to assess the quality of interaction with chatbots and (ii) the designing and piloting a new scale to measure satisfaction after the experience with chatbots. Two instruments were developed: (i) A diagnostic tool in the form of a checklist (BOT-Check). This tool is a development of previous works which can be used reliably to check the quality of a chatbots experience in line with commonplace principles. (ii) A 15-item questionnaire (BOT Usability Scale, BUS-15) with estimated reliability between .76 and .87 distributed in five factors. BUS-15 strongly correlates with UMUX-LITE by enabling designers to consider a broader range of aspects usually not considered in satisfaction tools for non-conversational agents, e.g. conversational efficiency and accessibility, quality of the chatbot’s functionality and so on. Despite the convincing psychometric properties, BUS-15 requires further testing and validation. Designers can use it as a tool to assess products, thus building independent databases for future evaluation of its reliability, validity and sensitivity.},
  keywords = {Q667, FF3=1, FF5=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract: Vier Studien (141 Teilnehmende) entwickeln BOT-Check und die Chatbot Usability Scale BUS-15 (Reliabilität 0,76–0,87, fünf Faktoren, korreliert mit UMUX-LITE). Einsetzbares Instrument für die Laienevaluation der Sprachschnittstelle (FF5, FF3 am Rand); laut Autoren noch weiter zu validieren, deutsche Fassung fehlt.},
}

@article{boumova2016apartment,
  author = {Boumová, Irena and Zdráhalová, Jana},
  title = {The Apartment with the Best Floor Plan Layout: Architects versus Non-architects},
  year = {2016},
  journal = {Critical Housing Analysis},
  volume = {3},
  number = {1},
  pages = {1},
  doi = {10.13060/23362839.2016.3.1.264},
  url = {https://www.housing-critical.com/data/USR_057_DEFAULT/The_Apartment_with_the_Best_Floor_Plan_Layout_Architects_versus_Non_architects_final(3).pdf},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von hanson1998decoding, vorwärts.},
  abstract = {This study examined differences in the floor-plan preferences of architects and laypersons with no architectural education or experience (non-architects).Qualitative data on floor-plan preferences were collected using interviews and an online survey.The floor plans used in the online survey were differentiated primarily by spatial arrangements and included the original layout of a socialist prefab apartment and two contemporary redesigns of the space.The results showed significant differences in the floor-plan preferences of architects and non-architects.Topological properties of layout and a required level of privacy were identified as key factors influencing the between-group differences.Architects and non-architects disagreed in particular over how the public and private zones were defined and arranged in the apartment layouts.From the perspective of architectural practice, understanding non-architects' preferences can decrease the uncertainty in new product development for an unknown end user and increase residential satisfaction.},
  keywords = {Q668, FF5=1, FF6=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract: Interviews und Online-Befragung zu drei Grundrissvarianten einer Plattenbauwohnung: Architekten und Laien unterscheiden sich systematisch, vor allem bei Topologie, Privatheit und der Trennung öffentlicher und privater Zonen. Stützt die Empfehlungslogik zu Zonierung und Privatheitsgradient (FF6, 9b) und die Rollenverteilung Laie/Architekt (FF5); tschechischer Geschosswohnungsbau.},
}

@article{campogay2026quality,
  author = {Campo Gay, Irene and Sandrin, Enrico and Hvam, Lars and Forza, Cipriano and Jensen, Patrik and Adén, Erik and Ernfors, Johan},
  title = {Impact of configuration systems on quality. A longitudinal case study in the construction industry},
  year = {2026},
  journal = {International Journal of Construction Management},
  pages = {1--21},
  doi = {10.1080/15623599.2026.2724955},
  url = {https://www.tandfonline.com/doi/pdf/10.1080/15623599.2026.2724955?needAccess=true},
  note = {[U] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Unsicher: Band/Heft im Record noch nicht vergeben (Online-First). Schneeball von schoenwitz2017product, vorwärts.},
  abstract = {This paper addresses a critical gap in construction management research by investigating the role of configuration systems in improving the quality of construction specifications, such as bills of materials and drawings, which are essential for efficient construction processes. While configuration systems have been widely studied in manufacturing as digital enablers of mass customization, their impact on the construction industry—particularly in reducing specification errors—remains underexplored. Using a longitudinal case study of 18 customized projects at a Swedish construction firm over a five-year period, this research provides the first empirical evidence in the construction industry that demonstrates how configuration systems can significantly reduce specification errors, from 51% without their use to just 1%. These improvements not only enhance specification accuracy but also streamline production processes, making them more consistent and efficient. The study’s findings offer practical insights into how configuration systems can support customization and operational scalability while maintaining high-quality control, especially for firms engaged in modular and off-site construction. The research emphasizes the importance of adopting these systems to improve production efficiency and reduce costly errors, contributing to both academic literature and industry practices.},
  keywords = {Q669, FF2=1, FF5=3, Nutzung:übernehmen, Qualitaet:B, Kernbestand},
  annote = {Abstract: Längsschnitt-Fallstudie über 18 kundenindividuelle Projekte eines schwedischen Bauunternehmens in fünf Jahren; Fehler in Bauspezifikationen (Stücklisten, Zeichnungen) sinken mit Konfigurationssystem von 51 % auf 1 %. Trägt die Fehlerquote-Hypothese (FF5) mit dem ersten Längsschnittbefund im Bauwesen; Einzelfirma. Online-First, Band und Heft noch nicht vergeben.},
}

@article{cannas2022eto,
  author = {Cannas, Violetta Giada and Masi, Antonio and Pero, Margherita and Brunø, Thomas Ditlev},
  title = {Implementing configurators to enable mass customization in the Engineer-to-Order industry: a multiple case study research},
  year = {2022},
  journal = {Production Planning \& Control},
  volume = {33},
  number = {9-10},
  pages = {974--994},
  doi = {10.1080/09537287.2020.1837941},
  url = {http://hdl.handle.net/11311/1170869},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2020. Schneeball von schoenwitz2017product, vorwärts.},
  abstract = {Engineer-to-Order (ETO) companies are embracing the mass customisation strategy to face the challenges posed by global competition. Product configurators are key enablers of such strategy. Despite the benefits, the actions to perform to manage the challenges of implementing product configurators are still understudied. This paper aims to fill this gap by empirically exploring seven case studies of ETO companies that are embracing a mass customisation strategy and have implemented a product configurator. The results provide a classification of the challenges that ETO companies have to manage in each phase of the implementation of product configurators, and a framework that supports managers in defining the actions necessary for the development and implementation of product configurators. This study, thereby, contributes to the debate on how ETO companies can move towards a mass customisation paradigm.},
  keywords = {Q670, FF2=1, FF5=2, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: Sieben Fallstudien in Engineer-to-Order-Firmen klassifizieren die Herausforderungen je Einführungsphase eines Produktkonfigurators und ergeben einen Handlungsrahmen für Manager. Stützt FF5 bei Einführung und Arbeitsteilung beim Hersteller; Maschinen- und Anlagenbau, kein Hausbau. Online 2020, Heftjahrgang 2022.},
}

