@phdthesis{prochiner2006homes24,
  author = {Prochiner, Frank},
  title = {Homes 24 -- Zukunftsorientierte Fertigungs- und Montagekonzepte im industriellen Wohnungsbau},
  year = {2006},
  school = {Technische Universit\"at M\"unchen, Fakult\"at f\"ur Architektur},
  url = {https://mediatum.ub.tum.de/601021},
  note = {[V] verifiziert via mediaTUM (Dissertation, Betreuer G. Hausladen).},
  abstract = {Die vorliegende Arbeit befasst sich mit den Methoden der industriellen Vorfertigung. Beginnend bei den Pionieren der industriellen Fertigung wird die Entwicklung von Bauweisen und Produktionstechniken bis zum heutigen Stand der Technik dargestellt. In der Analogie zum Fahrzeugbau werden Zielvisionen für den industriellen Wohnungsbau dargestellt. Anhand eigener Entwicklungen und Erfindungen werden technische Lösungen vorgestellt, wie in Zukunft die einzelnen Gewerke in die Vorfertigung verlagert werden können, um den Vorfertigungsgrad im Fertigbau auf nahezu 100 % zu steigern. Neue Montage- und Verbindungssysteme werden vorgestellt, mit denen es in Zukunft gelingen kann, sogenannte "Homes (24)" als Plug & Play Haussystem, steckbar zu machen.},
  keywords = {Q415, FF5=1, FF6=2, Nutzung:adaptieren, Qualitaet:B, Kernbestand, Prochiner, Homes 24, Munitec, Automatisierung, Vorfertigung, Fertighaus, Fertigbau, Gewerkeintegration, Plug & Play, Schnellverbinder, Robotik, industrielles Bauen, Industrialisierung},
  annote = {(ohne Abstract) TUM-Dissertation zu Fertigungs- und Montagekonzepten im industriellen Wohnungsbau mit Gewerkeintegration „Plug & Play“ und vorinstallierter TGA im Element; historische Referenz für werkseitige Vorinstallation (FF6). 2006, kein BIM/IFC.},
}

@mastersthesis{hoch2026bimefh,
  author = {Hoch, Franziska},
  title = {BIM im Kleinprojektbereich -- Entwicklung und Analyse eines praxisorientierten Systems f\"ur Planung und Ausf\"uhrung im Einfamilienhausbau},
  year = {2026},
  school = {Technische Universit\"at Wien},
  type = {Diplomarbeit},
  url = {https://repositum.tuwien.at/bitstream/20.500.12708/229278/1/},
  note = {[V] verifiziert via reposiTUm-PDF (Jahr aus Dateiname). Kontext, Massivbau.},
  abstract = {Building Information Modeling (BIM) kann als Optimierungswerkzeug zwischen Planung und Ausführung während der Bauphase die Zeit- und Kosteneffizienz steigern. Während BIM in Mittel- und Großunternehmen, die sowohl national als auch international tätig sind, bereits verbreitet ist, ist die Anwendung in Kleinunternehmen noch wenig etabliert. Dies liegt oft an mangelnden finanziellen und zeitlichen Ressourcen, fehlender Bereitschaft zur Aufwendung dieser Ressourcen, sowie unzureichenden Kenntnissen, die für die Umsetzung benötigt werden. Dabei investieren viele Planungsbüros in teure Software, die für die BIM-Anwendung ausgelegt wären, jedoch wird das Potential dieser Programme kaum ausgeschöpft. Die Anwendung von BIM bei Einfamilienhausprojekten könnte nicht nur die Kommunikation zwischen den Projektbeteiligten verbessern, sondern auch den Bauherren trotz fehlenden Fachwissens mehr Transparenz und Kontrolle ermöglichen. Ziel der vorliegenden Arbeit ist die Entwicklung und Analyse einer praxisorientierten BIM-Anwendung für ein Kleinunternehmen, das sowohl Planung als auch Ausführung von Bauprojekten anbietet. Im Zentrum steht die Erstellung eines Templates zur Generierung BIM-basierter Projekte sowie einer darauf aufbauenden Projektdatei für die Anwendung in Planung und Ausführung, wodurch ein durchgängiges System entsteht. Der Fokus liegt dabei insbesondere auf der Ausführungsplanung und der Umsetzung des Rohbaus in Massivbauweise. Im Zuge der Arbeit werden die gewonnenen Erkenntnisse in einen strukturierten Planungsprozess eingeordnet und bilden die Grundlage für die Weiterentwicklung des Systems. Ergänzend dazu wird der praktische Nutzen der entwickelten BIM-Anwendung für unterschiedliche Benutzergruppen untersucht. Im Fokus stehen dabei insbesondere Planer, Poliere und Bauherren, deren Anforderungen und Arbeitsweisen in die Analyse einfließen. Ziel ist es, die Anwendung nicht nur aus planerischer Perspektive, sondern auch im Hinblick auf die Ausführung sowie die Nutzung auf der Baustelle zu bewerten. Abschließend werden die Ergebnisse der Analyse zusammengeführt und im Kontext der Anwendbarkeit von BIM im Kleinprojektbereich eingeordnet. Dabei wird insbesondere betrachtet, unter welchen Voraussetzungen eine sinnvolle und wirtschaftliche Nutzung im Einfamilienhausbau möglich ist.},
  keywords = {Q416, FF1=1, FF5=1, Nutzung:Kontext, Qualitaet:C, Peripherie, BIM, Massivbauweise, Ausführungsplanung},
  annote = {(ohne Abstract) Diplomarbeit zu einem BIM-Template für Planung und Ausführung eines Einfamilienhauses im Kleinunternehmen; nur Kontext (FF1, FF5), Massivbau und Österreich. Qualität C als Abschlussarbeit.},
}

@thesis{kuhl2023robotik,
  author = {Kuhl, Janina Bea Doreen},
  title = {Robotik im Holzbau: Untersuchung grundlegender Fragen der Vorfertigung},
  year = {2023},
  school = {Hochschule f\"ur Technik, Wirtschaft und Kultur Leipzig},
  type = {Bachelorarbeit},
  note = {[U] nur über Exa-Bibliothekseintrag mit Volltextauszug (Abgabe 26.09.2023) gefunden; Repositorium nicht ermittelt. Nicht zitieren ohne Nachweis.},
  abstract = {Die vorliegende Bachelorarbeit untersucht die Thematik der Vorfertigung im Holzbau und zielt darauf ab, einen umfassenden Einblick zu der Entwicklung, den Praktiken, den Herausforderungen und Potentialen zu geben. Angesichts des steigenden Fachkräftemangels sowie der wachsenden Nachfrage nach bezahlbarem, qualitativ hochwertigem Wohnraum stellt die Produktion im Werk eine entscheidende Komponente für die zukünftige Entwicklung der Bauindustrie dar. Dabei wird die Integration von automatisierten Lösungen und Robotik thematisiert. Das Ziel dieser Arbeit besteht darin, die Möglichkeiten und Herausforderungen der Integration solcher Systeme zu untersuchen und Handlungsempfehlungen für die Umsetzung in Werkhallen abzuleiten. Um einen ausgewogenen Überblick zu gewährleisten, basiert die Untersuchung auf einer Analyse der traditionellen Vorfertigung und deren Limitation. Dabei werden zusätzlich automatisierte Technologien berücksichtigt. Ein Hauptaugenmerk liegt darauf, wie Robotik in diesem Kontext den Produktionsprozess optimieren kann. Im Zuge dieser Analyse werden Vorteile wie Effizienzsteigerung, Produktivität, Präzision und Ressourcenmanagement sowie potenzielle Herausforderungen in Bezug auf eine hohe Anfangsinvestition, Schulungsbedarf und Flexibilitätseinschränkungen herausgestellt. Die wichtigsten Erkenntnisse, aus der Quellenarbeit und den Experteninterviews, zeigen die wachsende Bedeutung der Integration von Robotik in der Vorfertigung im Holzbau und verdeutlichen die Notwendigkeit weiterer Forschung und Entwicklung in diesem Bereich. Die vorliegende Arbeit legt einen Grundstein für das Verständnis der Vorfertigungsprozesse, die Integrationsmöglichkeit verschiedener Technologien und fördert das Verständnis der Potenziale und Herausforderungen, die mit der Nutzung dieser Technologien einher gehen. Die Arbeit betont die Bedeutung der weiteren Forschung und Implementierung von Robotik in der Vorfertigung, um die Wettbewerbsfähigkeit und Zukunftsfähigkeit der Holzbaubranche zu sichern und innovative Fortschritte voranzutreiben.},
  keywords = {Q417, FF5=1, Nutzung:verwerfen, Qualitaet:C, Peripherie},
  annote = {Bachelorarbeit HTWK Leipzig (Abgabe 26.09.2023) zu Vorfertigung und Robotik mit Experteninterviews; inhaltlich nur Kontext (FF5) und durch Q394 abgedeckt. Nur über Exa-Bibliothekseintrag mit Volltextauszug belegt, kein Repositorium; BibTeX-Typ „thesis“ unpräzise.},
}

