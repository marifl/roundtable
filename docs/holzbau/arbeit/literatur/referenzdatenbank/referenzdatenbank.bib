  annote = {Abstract: Toolkits für Nutzerinnovation entwickeln kundenindividuelle Produkte schneller und günstiger als herstellerzentrierte Bedarfserhebung. Stützt Selbstentwurf und Durchlaufzeit (FF5) sowie den Lösungsraum als Regelraum (FF2); Erfahrungsberichte, keine kontrollierte Studie, kein Bauwesen.},
}

@article{wang2023perception,
  author = {Wang, Yue and Mo, Daniel Y. and Ma, Hoi Lam},
  title = {Perception of time in the online product customization process},
  year = {2023},
  journal = {Industrial Management \& Data Systems},
  volume = {123},
  number = {2},
  pages = {369--385},
  doi = {10.1108/imds-03-2022-0159},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2022. Schneeball von randall2007user, vorwärts.},
  abstract = {Purpose
Many e-commerce companies adopt a product customization platform offering various choices for customers to configure products to better satisfy their needs. However, a method to effectively measure customer satisfaction is lacking. This paper aims to investigate customers' perception of time in the online configuration process of customized products and seeks to propose time perception as the measurement of the effectiveness of online product customization.
Design/methodology/approach
An online laptop customization system was used in an empirical experiment to collect respondents' answers in a set of research questions. Regression and correlation analysis were conducted to investigate the factors affecting customers' satisfaction as well as the relationships with time perception.
Findings
The experimental results reveal several factors in customers' perception of time during the online product customization process. First, customers tend to overestimate the amount of time spent in a short-duration task but underestimate the amount of time spent in a long-duration task. Second, customers' perceptions of time are significantly correlated with their satisfaction with the configured products, and perceived time is moderately correlated with their satisfaction with the configuration process. Third, the difficulty of customization tasks and customers' motivation to process information also significantly affect customers' perceptions of time.
Originality/value
This paper advances the research on time perception by developing a new relative segmentation-based method to estimate the subjective perception of time. This study also makes several contributions to product customization research: the authors fill a research gap in the field of product customization by incorporating customers' perceptions of time into the measurement of customer satisfaction and by identifying the significant relationships among customers' perception of time, the ease of task selection, the customers' motivation to process information, and customers' satisfaction with customized products. These results aid in the design of online product customization systems.},
  keywords = {Q728, FF5=2, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract: Laptop-Konfigurationsexperiment; kurze Aufgaben werden überschätzt, lange unterschätzt, wahrgenommene Zeit korreliert mit Zufriedenheit. Liefert ein Maß (wahrgenommene Zeit) für die Laienstudie neben gemessener Zeit (FF5); Konsumgut. OpenAlex: IMDS 123(2), 369–385, online 2022.},
}

@article{wyke2025productivity,
  author = {Wyke, Simon and Lindhard, Søren Munch and Mincheva, Kameliya and Georgieva, Mihaela and Svidt, Kjeld},
  title = {Factors influencing design productivity in Denmark: implications for enhanced design management},
  year = {2025},
  journal = {Architectural Engineering and Design Management},
  pages = {1--18},
  doi = {10.1080/17452007.2025.2561754},
  url = {https://doi.org/10.1080/17452007.2025.2561754},
  note = {[U] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Unsicher: Band/Heft im Record noch nicht vergeben (Online-First). Schneeball von sacks2008impact, vorwärts.},
  abstract = {An increase in design complexity, participants, and technologies, has heightened the focus on general productivity and design productivity within the architectural, engineering and construction (AEC) industry. However, measuring design productivity through traditional means has proven insufficient. To know more about what constitutes high-design productivity, 25 factors, affecting design productivity, were identified and ranked based on survey answers from 80 respondents working with architecture and engineering in Denmark. The statistical analysis revealed a close ranking of a multitude of the 25 factors, with factors contained in the management factor category being significantly more important than labour and technical factors ranking 2 and 3, while project factors ranked 4, and the external factors ranked 5. However, to manage design productivity efficiently, this study showed that focusing on only management factors is not enough, and that various interrelationships are detectable between the 25 factors quantitatively and qualitatively. This study adds to the existing body of knowledge by focusing on the underlying factors affecting design productivity, providing guidance for project managers on where to focus to manage and improve design productivity.},
  keywords = {Q729, FF5=2, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: Umfrage unter 80 Planenden in Dänemark rangiert 25 Faktoren der Planungsproduktivität; Managementfaktoren wiegen schwerer als technische. Kontext und Gegengewicht zur Technikwirkung (FF5); Selbstauskunft, kein Holzbau. Online-First (AEDM, S. 1–18), Band und Heft noch nicht vergeben.},
}

@article{yi2022configurator,
  author = {Yi, Minzhe and Huang, Zihao and Yu, Yuxiang},
  title = {Creating a Sustainable E-Commerce Environment: The Impact of Product Configurator Interaction Design on Consumer Personalized Customization Experience},
  year = {2022},
  journal = {Sustainability},
  volume = {14},
  number = {23},
  pages = {15903},
  doi = {10.3390/su142315903},
  url = {https://www.mdpi.com/2071-1050/14/23/15903/pdf?version=1669718745},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von trentin2013sales, vorwärts.},
  abstract = {Promoting consumers’ willingness to pay is crucial to creating a sustainable e-commerce environment, and the interaction design of the product configurator plays a key role in this. In the present study, the product configurator, which is indispensable in online customization, is adopted as the research object to analyze the influence of interaction design on the customization experience of consumers. The pricing method (total product pricing, incomplete total product pricing, and individual module pricing) and navigation design pattern (tabs and dropdown menu with arrow buttons) are adopted as independent variables, while system usability, flexible navigation capability, perceived control, perceived enjoyment, complexity and task performance are taken as dependent variables. One hundred and eighty college students participated in this study. The results of the 3 × 2 two-factor experiment reveal that: (1) Different navigation design patterns will lead to significant differences in system usability, flexible navigation capability, and perceived control of the product configurator, and tabs are better than dropdown menu with arrow buttons in these aspects. (2) Different pricing methods will significantly affect the perceived control of users. Under individual module pricing and incomplete total product pricing, perceived control is higher. (3) Different combinations of pricing methods and navigation design patterns will affect users’ evaluation of flexible navigation capability and complexity, and under the individual module pricing and incomplete total product pricing methods, users think that tabs have a higher flexible navigation capability and lower complexity. However, under the total product pricing method, users are convinced that dropdown menu with arrow buttons has a higher flexible navigation capability and lower complexity. The research results are of great significance to both interface interaction design and online customization. Furthermore, the interaction design method of price presentation and navigation design of the product configurator is analyzed to determine the most appropriate interaction design principles, so as to enhance the user experience of online customization and provide constructive ideas from the design perspective for online customization.},
  keywords = {Q730, FF5=1, FF6=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: 3×2-Experiment mit 180 Studierenden; Tabs schlagen Dropdown-Navigation, Einzelmodul-Preise erhöhen wahrgenommene Kontrolle. Nur Kontext für Oberfläche und Mehrpreisdarstellung der Bemusterung (FF5/FF6); studentische Stichprobe, Konsumgut.},
}

@article{zhao2019toolkits3d,
  author = {Zhao, Huiwen and McLoughlin, Leigh and Adzhiev, Valery and Pasko, Alexander},
  title = {3D Mass Customization Toolkits Design, Part I: Survey and an Evaluation Model},
  year = {2019},
  journal = {Computer-Aided Design and Applications},
  volume = {16},
  number = {2},
  pages = {204--222},
  doi = {10.14733/cadaps.2019.204-222},
  url = {https://doi.org/10.14733/cadaps.2019.204-222},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Jahr = Heftjahrgang; OpenAlex führt Online-Jahr 2018. Schneeball von randall2007user, vorwärts.},
  abstract = {Mass customization (MC) allows consumers to design their own products or services through online MC toolkits. The application of geometric modeling through modern web-browsers allows for the presentation of a virtual 3D product, resulting in a number of commercial 3D MC sites. To gain a deeper understanding of the toolkits that drive these sites, this article provides a comprehensive investigation into web-based toolkit design. Based on this review, an evaluation model for 3D MC toolkits is proposed that considers four aspects: Individual Differences, Solution Space, Interaction Design and Enabling Technologies. This leads to a follow-up article that applies the 3D toolkit evaluation model to assess commercial 3D toolkits which are available on the current market.},
  keywords = {Q731, FF5=2, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Abstract (Verlagsseite; OpenAlex-Abstract ist nur Zeitschriftentext): Übersicht webbasierter 3D-Mass-Customization-Toolkits und Bewertungsmodell mit vier Aspekten (individuelle Unterschiede, Lösungsraum, Interaktion, Technik). Als analytisches Bewertungsraster für den Prototyp nutzbar (FF5), Kontext für 3D-Präsentation (FF6). OpenAlex: online 2018, Heft 16(2) 2019.},
