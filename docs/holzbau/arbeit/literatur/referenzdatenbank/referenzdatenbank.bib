  note = {[V] Crossref (Exa-Fetch); Abstract über OpenAlex gelesen. Schneeball von sydora2020rulebased, vorwärts. Relevanz vorläufig ff1=0, ff2=2, ff4=0.},
  abstract = {This paper presents the Eurocode Core Ontology (ECO), a foundational semantic framework that formalizes the core logic of the Eurocodes to enable machine-readable interpretation and intelligent verification. The Eurocodes provide a comprehensive regulatory framework for structural design, yet their natural language formulation hinders integration into digital workflows and automated reasoning systems. Developed as a modular and extensible framework, the ECO encodes key concepts from Eurocode 0 (EN 1990) and models actions and partial factors from Eurocode 1 (EN 1991) through declarative rules. Grounded in established ontological standards such as SKOS, QUDT, BFO, EMMO and BOT, the ontology supports semantic interoperability across engineering tools. The paper investigates the capability of ECO for the design of a concrete floor slab through rule-based inference, compliance checking, and BIM integration. These results establish a foundation for future domain-specific extensions and confirm the feasibility of applying Semantic Web technologies to standards-based structural design. ECO provides a foundation for next-generation digital tools enabling automated, standard-compliant structural design.},
  keywords = {Q562, FF2=1, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {(ohne Abstract) Kernontologie der Eurocodes als semantische Grundlage für Tragwerks-Assistenten. Kontext für die Vorbemessung nach EC 5 (FF2); Ontologie ohne deutschen NA und ohne Holzbaubezug. OpenAlex führt 2025 (online), Band 70 ist 2026.},
}

@article{khaliliaraghi2020variability,
  author = {Khalili-Araghi, Salman and Kolarevic, Branko},
