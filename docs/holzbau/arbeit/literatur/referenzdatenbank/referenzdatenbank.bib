  url = {https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/9783433612095.ch15},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403) und Crossref-Record (Exa-Fetch); Abstract gelesen (OpenAlex). Autorname dort fehlerhaft ("Chäteauvieux"), korrigiert nach mediaTUM. Schneeball von chateauvieux2023bim, vorwärts.; korrigiert 2026-09-27: Herausgeber Fouad, Nabil A. ergänzt (Crossref edited-book 10.1002/9783433612095; Verlagsangabe)},
  abstract = {Open BIM-Methoden ermöglichen herstellerneutrale, digitale Planungsprozesse der Zukunft. Die Autorinnen zeigen auf, wie open BIM-Aspekte in einen Planungsprozess für den Schallschutz integriert werden können. Neben einem kurzen Überblick über den aktuellen Stand der Technik wird der Aufbau von IFC-Dateien erläutert. Zusätzlich wird eine Schemaerweiterung vorgeschlagen, um zukünftig mit Fachmodellen für die Bauakustik arbeiten zu können. Auch für die Datenübergabe der planerischen Eingangsdaten und der Berechnungsergebnisse wird eine Lösung anhand eines Datenschemas vorgestellt. Dieses kann für JSON- oder XML-Dateien genutzt werden. Durch diese externen Dateien in Kombination mit dem digitalen Gebäudemodell in IFC kann bereits heute ein Fachmodell Akustik erstellt werden. Dieser Ansatz zeigt das Potenzial der open BIM-Planung, das in den nächsten Jahren auch für die gesamte Bauphysik zu einer integralen Planung führen könnte.},
  keywords = {Q753, FF1=2, FF6=3, Nutzung:adaptieren, Qualitaet:C, Kernbestand},
  annote = {Abstract: Open-BIM-Planungsprozess für den Schallschutz mit IFC-Aufbau, vorgeschlagener Schemaerweiterung und JSON-/XML-Datenschema für Eingangsdaten und Ergebnisse eines Fachmodells Akustik. Übernehmbar ist das Datenschema (FF6); die Schemaerweiterung widerspricht „nur Standard“ und ist über Psets und Dokumentreferenzen zu ersetzen (FF1). Bibliografie: Herausgeber fehlt, Fouad, Nabil A. (Hrsg.), Bauphysik-Kalender 2025, Ernst & Sohn, S. 525–548 (Verlagsseite).},
}

@article{cheung2012cost,
  author = {Cheung, Franco K.T. and Rihan, Jonathan and Tah, Joseph and Duce, David and Kurul, Esra},
  title = {Early stage multi-level cost estimation for schematic BIM models},
  year = {2012},
  journal = {Automation in Construction},
  volume = {27},
  pages = {67--77},
