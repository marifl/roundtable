@article{napps2026digitalizing,
  author = {Napps, Daniel and Aziz, Angelina and K\"onig, Markus},
  title = {Digitalizing workplace safety regulations for rule-based validation of escape routes and movement areas in BIM},
  year = {2026},
  journal = {Automation in Construction},
  volume = {186},
  pages = {106883},
  doi = {10.1016/j.autcon.2026.106883},
