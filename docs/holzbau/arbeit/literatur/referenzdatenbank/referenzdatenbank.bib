  note = {[V] Crossref (Exa-Fetch); Abstract über OpenAlex gelesen. Schneeball von fischer2025bridging, rückwärts. Relevanz vorläufig ff1=2, ff2=2, ff4=0.},
  abstract = {IDMs are suited for describing construction data exchange providing textual specifications of EIR for IFC data. Given the amount of heterogeneous construction data beyond IFC and the inconsistency of requested data, this paper proposes to define human- and machine-readable EIR for the exchange of standardized ICDD containers, which integrate and link heterogeneous data in a single package. To specify the required quality of ICDD containers, an ontology is defined based on the standardized LOIN schema. The developed ontology is evaluated in a use case and can be used to formulate the EIR for the interconnected packaged ICDD data within IDM.},
  keywords = {Q581, FF1=2, FF2=1, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
