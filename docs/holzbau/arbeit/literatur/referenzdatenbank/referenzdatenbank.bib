@article{lin2026defects,
  author = {Lin, Jia-Rui and Cai, Yunhong and Ni, Xiang-Rui and Pan, Peng},
  title = {Intelligent identification and correction of property-related design defects in BIM via large language models},
  year = {2026},
  journal = {Automation in Construction},
  volume = {192},
  pages = {107218},
  doi = {10.1016/j.autcon.2026.107218},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Screening nach Titel, Publikationsorgan und Zitationskontext (kein Abstract im Record). Schneeball von du2026text2bim, vorwärts.},
  abstract = {Existing Building Information Modeling (BIM) checking methods focus on specific design defect types, while failing to identify and correct multi-type property-related BIM design defects in one loop. Therefore, this paper proposes an integrated framework to identify and correct multi-type property-related design defects in BIM via Large Language Models (LLMs). First, a BIM-to-Text method with component-balanced chunking is introduced to bridge BIM data and LLMs. Then, a prompt learning based method incorporating rule injection and few-shot prompting is proposed for defect identification, and a Retrieval Augmented Generation (RAG) method is established for correction suggestions. A hallucination control strategy combining key-identifier validation and token-length thresholds is developed to improve reliability. Experiments show that the proposed approach outperforms rule checking, and the fine-tuned LLM improves identification accuracy by 15%, with a 94% rationality rate for correction suggestions. Hallucination control increases accuracy from 64% to 85%, eliminating 92.5% of hallucinations in one round.},
  keywords = {Q652, FF2=2, FF3=1, FF5=1, Nutzung:abgrenzen, Qualitaet:B, Peripherie},
  annote = {Abstract (Autorenseite): BIM-to-Text, Regelinjektion und Few-Shot-Prompting erkennen merkmalsbezogene Entwurfsfehler, RAG schlägt Korrekturen vor; Halluzinationskontrolle hebt die Genauigkeit von 64 % auf 85 %. Gegenposition zu FF2: LLM-Prüfung übertrifft laut Autoren Regelprüfung, bleibt aber bei 15 % Fehlern ungeeignet für haftungsrelevante Prüfungen; FF3 und FF5 am Rand.},
}

@article{makatura2024llm,
  author = {Makatura, Liane and Foshey, Michael and Wang, Bohan and Hähnlein, Felix and Ma, Pingchuan and Deng, Bolei and Tjandrasuwita, Megan and Spielberg, Andrew and Owens, Crystal and Chen, Peter Yichen and Zhao, Allan and Zhu, Amy and Norton, Wil and Gu, Edward and Jacob, Joshua and Li, Yifei and Schulz, Adriana and Matusik, Wojciech},
  title = {How Can Large Language Models Help Humans in Design and Manufacturing? Part 1: Elements of the LLM-Enabled Computational Design and Manufacturing Pipeline},
  year = {2024},
  journal = {Harvard Data Science Review},
  number = {Special Issue 5},
  doi = {10.1162/99608f92.cc80fe30},
  url = {https://hdsr.mitpress.mit.edu/pub/15nqmdzl/download/pdf},
  note = {[V] OpenAlex-Record per DOI-Filter (api.openalex.org über Exa-Fetch, Direktzugriff 403); Abstract gelesen (OpenAlex). Schneeball von kodnongbua2024zeroshot, rückwärts.},
  abstract = {The advancement of Large Language Models (LLMs), including GPT-4, provides exciting new opportunities for generative design. We investigate the application of this tool through sequential steps of the computational design and manufacturing workflow. In particular, we examine how LLMs can aid in tasks including: converting a text-based prompt into a quantitative design specification, transforming a design into manufacturing instructions, producing a design space and variations within that space, computing the performance of a given design, and optimizing for designs predicated on performance goals. Through a series of examples, we highlight overarching capabilities and limitations of the current LLMs. By exposing these aspects, we aspire to catalyze the continued improvement and progression of these models, providing a roadmap to build on their strengths and reduce their weaknesses.},
  keywords = {Q653, FF1=1, FF3=2, Nutzung:Kontext, Qualitaet:B, Peripherie},
  annote = {Abstract: GPT-4 entlang der Kette Text → quantitative Spezifikation → Entwurfsraum → Fertigungsanweisung → Leistungsbewertung → Optimierung, mit Fähigkeiten und Grenzen an Beispielen. Kontext für FF3 (was Sprachmodelle in der Kette leisten und wo nicht) und FF1 am Rand; kein Bauwesen, qualitative Beispiele.},
}

