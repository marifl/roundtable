@article{johnson2012beyond,
  author = {Johnson, Eric J. and Shu, Suzanne B. and Dellaert, Benedict G. C. and Fox, Craig and Goldstein, Daniel G. and H\"aubl, Gerald and Larrick, Richard P. and Payne, John W. and Peters, Ellen and Schkade, David and Wansink, Brian and Weber, Elke U.},
