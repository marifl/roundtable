  annote = {Interaktives generatives System für partizipativen EFH-Entwurf, das Nutzerentscheidungen mit formalisierten Regeln prüft und korrigiert ('Korrektheitsgarantie'), mit Usability-Tests; stützt Regelraum-Prinzip (FF2) und Laienevaluation (FF5). Keine Konstruktion, keine Kosten, keine Sprache.},
}

@article{khalili2016development,
  author = {Khalili-Araghi, Salman and Kolarevic, Branko},
  title = {Development of a framework for dimensional customization system: A novel method for customer participation},
  year = {2016},
  journal = {Journal of Building Engineering},
  volume = {5},
  pages = {231--238},
  doi = {10.1016/j.jobe.2016.01.001},
  note = {Verifiziert über ScienceDirect (DOI) und NJIT-Forschungsportal},
  abstract = {Mass customization in the building industry is a relatively new concept. True adaptation of mass customization requires the participation of customers in design to better reflect their expectations. However, architects and homebuilders do not want to deviate from the efficiency of product standardization or selection among products with a standard design. The challenge of customer participation lies mostly in design validation, especially the code compliance checking it involves. This paper presents the conceptual framework for a dimensional customization system that reflects the potential of a constraint-based parametric design. Constraint-based parametric design offers a wide range of variations, while simultaneously complying to design rules.},
  keywords = {Q215, FF2=3, FF5=1, Nutzung:adaptieren, Qualitaet:B, Kernbestand},
  annote = {Rahmen für dimensionale Kundenanpassung mit constraint-basiertem Parametermodell (PDS) und Kundenkonfiguration (UCS); Kernaussage 'the challenge of customer participation lies mostly in design validation, especially the code compliance checking' trägt die Problemstellung von FF2. An Revit gebunden, nur Maß-Constraints, keine Fertigung.},
}

@inproceedings{puusepp2017enabling,
  author = {Puusepp, Renee and L\~ooke, Taavi and Kivi, Kaiko},
  editor = {Janssen, Patrick and Loh, Paul and Raonic, Aleksandra and Schnabel, Marc Aurel},
  title = {Enabling Customer Choice in Housing: Mass Customisation Solution for Prefabricated House Manufacturers},
  year = {2017},
  booktitle = {Protocols, Flows and Glitches -- Proceedings of the 22nd CAADRIA Conference},
  pages = {251--260},
  address = {Suzhou},
  doi = {10.52842/conf.caadria.2017.251},
  url = {http://papers.cumincad.org/data/works/att/caadria2017_046.pdf},
  note = {Verifiziert über CAADRIA-2017-Inhaltsverzeichnis (CumInCAD) und ETIS-Eintrag; korrigiert 2026-09-27: DOI ergänzt},
  abstract = {This paper presents a live and tested solution that enables home buyers to choose and customise their future homes in a web browser. It allows future owners and residents to configure and visualise their home in 3D but also keep it affordable by displaying the construction costs back to users in real-time. The proposed solution is analysed in the context of current housing market, excising web and BIM technologies and compared to currently available solutions. Additionally, we have been tracking visitor behaviour by using web analytics and can draw some conclusions about its performance.},
  keywords = {Q216, FF1=1, FF5=2, FF6=1, Nutzung:adaptieren, Qualitaet:B, Peripherie},
  annote = {Live-Webkonfigurator eines estnischen Fertighausherstellers mit Echtzeitkosten, Studie mit n=133: viele Nutzer bemerken Preisänderungen nicht, vom 3D-Modell getrennte Optionen verwirren; übernehmbar als Analytics-Evaluation (FF5) und Hinweis, Kosten in der Sprachantwort aktiv zu nennen. Nur teilweises Datenmodell, Rückbau im Autorensystem (ohne Abstract; nach Recherche 11). Bibliografie: DOI 10.52842/conf.caadria.2017.251 ergänzen.},
}

@mastersthesis{swanenburg2016towards,
  author = {Swanenburg, R.},
  title = {Towards successful mass customization strategies in Dutch house building: An application of the motivation-opportunity-ability framework to investigate the customer value of houses customized with a product configurator},
  year = {2016},
  school = {University of Twente},
  url = {https://essay.utwente.nl/essays/69474},
  note = {Masterarbeit, nicht begutachtet; verifiziert über essay.utwente.nl},
  abstract = {The objective of this study is to empirically investigate the customer value of a mass customization concept for houses by performing an on-line experiment with a configurator. The focus of this study is twofold. First, drivers of customer value that are based on the motivation-ability-opportunity (MOA) framework are investigated and tested. Second, the difference between two configurator designs is studied. Respondents, recruited from a large database of potential house buyers, designed a house with an on-line configurator and evaluated their design in a survey. They were randomly assigned to either a customization via starting solutions (CvSS) or attribute-by-attribute (AbA) customization approach. These two groups were compared to a control group that had to evaluate a standardized house design. The motivation measure ”process enjoyment”, opportunity measure ”design freedom” and ability measure ”ease of use” correlated with the two dependent variables, preference fit and purchase probability. After hierarchical regression analysis, ”design freedom” was found a predictor for preference fit. In addition, ”process enjoyment” was a predictor for both dependent variables. This means that the measures of the MOA framework can only be partly applied to evaluate the customer value of configurator based mass customization concepts in the Dutch house-building industry.},
  keywords = {Q217, FF5=2, Nutzung:adaptieren, Qualitaet:C, Peripherie},
  annote = {Randomisiertes Online-Experiment mit Kaufinteressenten: Konfiguration über Startlösungen gegen Attribut-für-Attribut gegen Standardhaus, Zielgrößen Preference Fit und Kaufwahrscheinlichkeit; Vorlage für den Vergleich Sprachdialog/Konfigurator/Katalog (FF5). Nicht begutachtete Masterarbeit, Niederlande.},
}

