  annote = {Abstract (OpenAlex): BIM-Werkzeuge für Holz sind unreif; formuliert funktionale Anforderungen und IDM/MVD für Entwurf und Analyse von Holzkonstruktionen. Kontext für 5.3 (FF1); Tagungsbeitrag, Stand 2012.},
}

