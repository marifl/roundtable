            },
            "auftritt_innen_min_mm": {
              "type": "number"
            },
            "verzogene_stufen": {
              "type": "integer"
            }
          }
        },
        "kopfhoehe_min_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "bauart": {
          "type": "string"
        },
        "holzart": {
          "type": "string"
        },
        "sortierung": {
          "type": "string"
        },
        "oberflaeche": {
          "type": "string"
        },
        "setzstufen": {
          "enum": [
            "offen",
            "geschlossen"
          ]
        },
        "gelaender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fuellung": {
              "type": "string"
            },
            "material": {
              "type": "string"
            },
            "lichter_abstand_mm": {
              "type": "number"
            },
            "hoehe_mm": {
              "type": "number"
            },
            "handlauf": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "material": {
                  "type": "string"
                },
                "profil": {
                  "type": "string"
                },
                "durchmesser_mm": {
                  "type": "number"
                },
                "hoehe_mm": {
                  "type": "number"
                }
              }
            }
          }
        },
        "quelle": {
          "type": "string"
        }
      }
    },
    "einbau": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "montageart": {
          "type": "string"
        },
        "vorwandsystem": {
          "type": "string"
        },
        "wand": {
          "type": "string"
        },
        "montagehoehe_mm": {
          "type": "number"
        },
        "achse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x_mm": {
              "type": "number"
            },
            "y_mm": {
              "type": "number"
            },
            "bezug": {
              "type": "string"
            }
          }
        },
        "bewegungsflaeche_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "anschluesse": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "medium"
            ],
            "additionalProperties": false,
            "properties": {
              "medium": {
                "enum": [
                  "abwasser",
                  "kaltwasser",
                  "warmwasser",
                  "strom",
                  "daten",
                  "abluft"
                ]
              },
              "dn": {
                "type": "number"
              },
              "leitung": {
                "type": "string"
              },
              "hoehe_ueber_okff_mm": {
                "type": "number"
              }
            }
          }
        },
        "tragkonstruktion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pruefung": {
      "type": "object",
      "required": [
        "regel",
        "ergebnis"
      ],
      "additionalProperties": false,
      "properties": {
        "regel": {
          "$ref": "#/$defs/regel_id"
        },
        "version": {
          "type": "string"
        },
        "ergebnis": {
          "enum": [
            "erfuellt",
            "verletzt",
            "unbestimmt",
            "nicht_anwendbar",
            "freigabepflichtig"
          ]
        },
        "text": {
          "type": "string"
        },
        "werte": {
          "type": "object"
        }
      }
    },
    "auswahl": {
      "type": "object",
      "required": [
        "schema",
        "auswahl_id",
        "reifegrad",
        "status",
        "kategorie",
        "kontext",
        "artikel"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "hrb-auswahl/0.1"
        },
        "auswahl_id": {
          "$ref": "#/$defs/uuid"
        },
        "vorgaenger": {
          "$ref": "#/$defs/uuid",
          "description": "bei Nachtrag: die ersetzte Auswahl"
        },
        "reifegrad": {
          "$ref": "#/$defs/reifegrad"
        },
        "status": {
          "enum": [
            "entwurf",
            "geprueft",
            "festgeschrieben",
            "nachtrag"
          ]
        },
        "kategorie": {
          "$ref": "#/$defs/kategorie"
        },
        "festgeschrieben_am": {
          "type": "string",
          "format": "date-time"
        },
        "inhaltshash": {
          "$ref": "#/$defs/sha256"
        },
        "kontext": {
          "type": "object",
          "required": [
            "projekt",
            "raum"
          ],
          "additionalProperties": false,
          "properties": {
            "projekt": {
              "type": "string"
            },
            "geschoss": {
              "type": "string"
            },
            "raum": {
              "type": "string"
            },
            "flaeche": {
              "type": "string",
              "description": "Boden, Wand Nord, Decke …"
            },
            "ifc_space_guid": {
              "$ref": "#/$defs/ifc_guid"
            },
            "flaeche_netto_m2": {
              "type": "number",
              "minimum": 0
            },
            "gebaeudetyp": {
              "type": "string"
            },
            "wohnungen": {
              "type": "integer",
              "minimum": 1
            },
            "profil": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "artikel": {
          "type": "object",
          "required": [
            "artikel_id"
          ],
          "additionalProperties": false,
          "properties": {
            "artikel_id": {
              "$ref": "#/$defs/artikel_id"
            },
            "variante_id": {
              "type": "string",
              "pattern": "^V[0-9]{2,3}$"
            },
            "hersteller": {
              "$ref": "#/$defs/hersteller"
            },
            "farbe": {
              "$ref": "#/$defs/farbe"
            },
            "oberflaeche": {
              "type": "string"
            },
            "format_mm": {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            },
            "dicke_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "merkmale": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/merkmal"
              }
            },
            "weitere_artikel": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rolle",
                  "artikel_id"
                ],
                "additionalProperties": false,
                "properties": {
                  "rolle": {
                    "type": "string"
                  },
                  "artikel_id": {
                    "$ref": "#/$defs/artikel_id"
                  },
                  "gtin": {
                    "$ref": "#/$defs/gtin"
                  },
                  "menge": {
                    "type": "number"
                  },
                  "einheit": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "leistung": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "verlegung": {
              "$ref": "#/$defs/verlegung"
            },
            "aufbau": {
              "$ref": "#/$defs/aufbau"
            },
            "treppe": {
              "$ref": "#/$defs/treppe"
            },
            "einbau": {
              "$ref": "#/$defs/einbau"
            },
            "oberflaeche": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "q_stufe": {
                  "enum": [
                    "Q1",
                    "Q2",
                    "Q3",
                    "Q4"
                  ]
                },
                "glanzgrad": {
                  "enum": [
                    "G1",
                    "G2",
                    "G3",
                    "G4"
                  ]
                },
                "nassabrieb": {
                  "type": "string"
                },
                "deckvermoegen": {
                  "type": "string"
                }
              }
            },
            "stlb_lb": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9]{3}$"
              }
            }
          }
        },
        "mengen": {
          "type": "object",
          "required": [
            "einheit",
            "menge",
            "quelle"
          ],
          "additionalProperties": false,
          "properties": {
            "einheit": {
              "enum": [
                "m2",
                "stueck",
                "m",
                "pauschal"
              ]
            },
            "menge": {
              "type": "number",
              "minimum": 0
            },
            "abrechnung_m2": {
              "type": "number",
              "minimum": 0,
              "description": "VOB-Fläche nach ATV DIN 18352 (Aussparungen bis 0,1 m² übermessen)"
            },
            "rohlinge": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "pakete": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "verschnitt_anteil": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bruch_reserve_anteil": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.2
            },
            "stuecke": {
              "type": "integer",
              "minimum": 0
            },
            "aus_reststueck": {
              "type": "integer",
              "minimum": 0
            },
            "schnitte_anzahl": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "schnittlaenge_m": {
              "type": "number",
              "minimum": 0
            },
            "schnittzeit_min": {
              "type": "number",
              "minimum": 0
            },
            "quelle": {
              "type": "string"
            }
          }
        },
        "kosten": {
          "type": "object",
          "required": [
            "mehrpreis",
            "formel_id",
            "gueltig_bis"
          ],
          "additionalProperties": false,
          "properties": {
            "mehrpreis": {
              "$ref": "#/$defs/geld"
            },
            "formel_id": {
              "type": "string"
            },
            "eingaben": {
              "type": "object"
            },
            "gueltig_bis": {
              "type": "string",
              "format": "date"
            },
            "ifc_cost_item_guid": {
              "$ref": "#/$defs/ifc_guid"
            }
          }
        },
        "termine": {
          "type": "object",
          "required": [
            "freeze"
          ],
          "additionalProperties": false,
          "properties": {
            "freeze": {
              "$ref": "#/$defs/freeze"
            },
            "freeze_termin": {
              "type": "string",
              "format": "date"
            },
            "lieferzeit_tage": {
              "type": "integer",
              "minimum": 0
            },
            "einbautermin": {
              "type": "string",
              "format": "date"
            },
            "spaetester_bestelltermin": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "folgen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "option",
              "domaene",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "option": {
                "type": "string",
                "pattern": "^OPT-[A-Z0-9-]+$"
              },
              "domaene": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "regel": {
                "$ref": "#/$defs/regel_id"
              },
              "beispiel": {
                "type": "string"
              }
            }
          }
        },
        "pruefungen": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pruefung"
          }
        },
        "ifc": {
          "$ref": "#/$defs/ifc_abbildung"
        },
        "freigabe": {
          "type": "object",
          "required": [
            "rolle",
            "datum"
          ],
          "additionalProperties": false,
          "properties": {
            "rolle": {
              "enum": [
                "Bauherr",
                "Projektleitung",
                "Tragwerksplanung",
                "bauvorlageberechtigte Person",
                "Werkplanung"
              ]
            },
            "datum": {
              "type": "string",
              "format": "date"
            },
            "ifc_approval_guid": {
              "$ref": "#/$defs/ifc_guid"
            }
          }
        },
        "lieferdaten": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "charge": {
              "type": "string"
            },
            "kaliber": {
              "type": "string"
            },
            "seriennummer": {
              "type": "string"
            },
            "geliefert_am": {
              "type": "string",
              "format": "date"
            }
          },
          "description": "Ist-Daten der Lieferung; nicht Teil des Inhaltshashs"
        },
        "suchschluessel": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "normalisierte Facetten 'kategorie:…', 'merkmal:Name=Wert[Einheit]' für die Suche (12.4.3)"
        },
        "hinweise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reifegrad": {
                "enum": [
                  "R",
                  "A"
                ]
              }
            }
          },
          "then": {
            "required": [
              "leistung",
              "pruefungen",
              "kosten",
              "termine"
            ],
            "properties": {
              "artikel": {
                "required": [
                  "artikel_id",
                  "hersteller"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reifegrad": {
                "const": "A"
              }
            }
          },
          "then": {
            "required": [
              "mengen",
              "ifc",
              "freigabe"
            ],
            "properties": {
              "artikel": {
                "properties": {
                  "hersteller": {
                    "anyOf": [
                      {
                        "required": [
                          "gtin",
                          "artikelnummer"
                        ]
                      },
                      {
                        "required": [
                          "einzelanfertigung",
                          "artikelnummer"
                        ],
                        "properties": {
                          "einzelanfertigung": {
                            "const": true
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "festgeschrieben",
                  "nachtrag"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "inhaltshash",
              "festgeschrieben_am"
            ],
            "properties": {
              "reifegrad": {
                "const": "A"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "nachtrag"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "vorgaenger"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kategorie": {
                "enum": [
                  "fliese",
                  "naturstein",
                  "boden_parkett",
                  "boden_elastisch",
                  "beton_cire"
                ]
              },
              "reifegrad": {
                "enum": [
                  "R",
                  "A"
                ]
              }
            },
            "required": [
              "kategorie",
              "reifegrad"
            ]
          },
          "then": {
            "properties": {
              "leistung": {
                "required": [
                  "verlegung",
                  "aufbau"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kategorie": {
                "enum": [
                  "fliese",
                  "naturstein"
                ]
              },
              "reifegrad": {
                "enum": [
                  "R",
                  "A"
                ]
              }
            },
            "required": [
              "kategorie",
              "reifegrad"
            ]
          },
          "then": {
            "properties": {
              "leistung": {
                "properties": {
                  "verlegung": {
                    "required": [
                      "muster",
                      "fugenbreite_mm",
                      "fuge",
                      "achsbezug"
                    ]
                  },
                  "aufbau": {
                    "required": [
                      "abdichtung"
                    ]
                  }
                }
              },
              "artikel": {
                "required": [
                  "artikel_id",
                  "hersteller",
                  "farbe",
                  "oberflaeche",
                  "format_mm"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kategorie": {
                "enum": [
                  "fliese",
                  "naturstein"
                ]
              },
              "reifegrad": {
                "const": "A"
              }
            },
            "required": [
              "kategorie",
              "reifegrad"
            ]
          },
          "then": {
            "properties": {
              "leistung": {
                "properties": {
                  "verlegung": {
                    "required": [
                      "rasterursprung_uv",
                      "silikon"
                    ]
                  }
                }
              },
              "mengen": {
                "required": [
                  "rohlinge",
                  "pakete",
                  "verschnitt_anteil"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kategorie": {
                "const": "treppe"
              },
              "reifegrad": {
                "enum": [
                  "R",
                  "A"
                ]
              }
            },
            "required": [
              "kategorie",
              "reifegrad"
            ]
          },
          "then": {
            "properties": {
              "leistung": {
                "required": [
                  "treppe"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kategorie": {
                "const": "sanitaer"
              },
              "reifegrad": {
                "enum": [
                  "R",
                  "A"
                ]
              }
            },
            "required": [
              "kategorie",
              "reifegrad"
            ]
          },
          "then": {
            "properties": {
              "leistung": {
                "required": [
                  "einbau"
                ]
              }
            }
          }
        }
      ]
    }
  }
}