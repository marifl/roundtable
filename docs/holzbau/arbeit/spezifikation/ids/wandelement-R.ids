<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>HRB Reifegrad R (prüffertig) – Holzrahmen-Wandelement mit Teilen und Verbindungsmitteln</title>
        <copyright>Arbeit Holzrahmenbau, Kapitel 11</copyright>
        <version>0.1.0</version>
        <description>Pflichtmerkmale der Bauteilgruppe 'wandelement' im Reifegrad R nach spezifikation/reifegrade.yaml (LOIN nach DIN EN ISO 7817-1:2024-11). Merkmale kumulativ (R erbt P, A erbt R); Granularitätsverbote nur für diesen Reifegrad.</description>
        <author>reifegrade@example.org</author>
        <date>2026-09-27</date>
        <purpose>Regel-, Nachweis-, Kompatibilitäts- und Kostenprüfung</purpose>
        <milestone>Vertrag, Bauvorlage, Entwurf der Ausstattungsfestlegung</milestone>
    </info>
    <specifications>
        <specification name="WAND-P-01 Wand: Außen/Innen und Material für die Darstellung" ifcVersion="IFC4X3_ADD2" identifier="WAND-P-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                </property>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="WAND-R-01 Wand: Tragwirkung, DIN-276-Klassifikation, Mengen" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <classification cardinality="required">
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="3[34][0-9]" />
                        </xs:restriction>
                    </value>
                    <system>
                        <simpleValue>DIN 276</simpleValue>
                    </system>
                </classification>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Length</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Height</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Width</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCAREAMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NetSideArea</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-R-02 Außenwand: U-Wert eingetragen (Grenzwert im Profil, z. B. HRB-01)" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-02">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCBOOLEAN">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>TRUE</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCTHERMALTRANSMITTANCEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ThermalTransmittance</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="0" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-R-V01 R: keine Verbindungsmittel (ANF-08-25)" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-V01">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCMECHANICALFASTENER</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements />
        </specification>
        <specification name="WAND-R-V02 R: keine Stabbearbeitungen (ANF-08-25)" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-V02">
            <applicability minOccurs="0" maxOccurs="0">
                <entity>
                    <name>
                        <simpleValue>IFCVOIDINGFEATURE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements />
        </specification>
    </specifications>
</ids>