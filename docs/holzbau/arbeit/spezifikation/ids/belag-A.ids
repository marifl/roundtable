            </applicability>
            <requirements>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Belag</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Holzart</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Belag</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Sortierung</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Belag</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Oberflaeche</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Belag</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Verlegeart</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="verklebt" />
                            <xs:enumeration value="schwimmend" />
                            <xs:enumeration value="genagelt" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="BEL-R-05 Bodenbelag: Fußbodenaufbau mit OKFF-Nachweis und R_λ,B (B14)" ifcVersion="IFC4X3_ADD2" identifier="BEL-R-05">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOVERING</simpleValue>
                    </name>
                    <predefinedType>
                        <simpleValue>FLOORING</simpleValue>
                    </predefinedType>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Kategorie</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Fliese" />
                            <xs:enumeration value="Naturstein" />
                            <xs:enumeration value="Parkett" />
                            <xs:enumeration value="Designboden" />
                            <xs:enumeration value="Laminat" />
                            <xs:enumeration value="Teppich" />
                            <xs:enumeration value="Beton_Cire" />
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Fussbodenaufbau</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>OKFF</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Fussbodenaufbau</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Estrich</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCTHERMALRESISTANCEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Fussbodenaufbau</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>R_lambda_B</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minInclusive value="0" fixed="false" />
                            <xs:maxInclusive value="0.5" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Fussbodenaufbau</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NachweisOKFF</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>TRUE</simpleValue>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="BEL-A-01 Belag: bestellbarer Artikel, Festschreibung, Menge" ifcVersion="IFC4X3_ADD2" identifier="BEL-A-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOVERING</simpleValue>
                    </name>
                    <predefinedType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="FLOORING" />
                            <xs:enumeration value="CLADDING" />
                        </xs:restriction>
                    </predefinedType>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Kategorie</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Fliese" />
                            <xs:enumeration value="Naturstein" />
                            <xs:enumeration value="Parkett" />
                            <xs:enumeration value="Designboden" />
                            <xs:enumeration value="Laminat" />
                            <xs:enumeration value="Teppich" />
                            <xs:enumeration value="Beton_Cire" />
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCIDENTIFIER" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ManufacturerTypeInformation</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>GlobalTradeItemNumber</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9]{8}|[0-9]{12,14}" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCIDENTIFIER" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_ManufacturerTypeInformation</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ArticleNumber</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCIDENTIFIER" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>AuswahlID</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCLABEL" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Status</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="festgeschrieben" />
                            <xs:enumeration value="nachtrag" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCIDENTIFIER" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Inhaltshash</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="sha256:[0-9a-f]{64}" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCNORMALISEDRATIOMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Verlegung</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Verschnitt</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minInclusive value="0" fixed="false" />
                            <xs:maxInclusive value="0.6" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="BEL-A-02 Fliese und Naturstein: Rasterursprung, Rohlinge und Pakete" ifcVersion="IFC4X3_ADD2" identifier="BEL-A-02">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCCOVERING</simpleValue>
                    </name>
                    <predefinedType>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="FLOORING" />
                            <xs:enumeration value="CLADDING" />
                        </xs:restriction>
                    </predefinedType>
                </entity>
                <property dataType="IFCLABEL">
                    <propertySet>
                        <simpleValue>HRB_Auswahl</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Kategorie</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="Fliese" />
                            <xs:enumeration value="Naturstein" />
                        </xs:restriction>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCNORMALISEDRATIOMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Verlegung</simpleValue>
