<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>HRB Reifegrad A (ausführungsfertig) – Holzrahmen-Wandelement mit Teilen und Verbindungsmitteln</title>
        <copyright>Arbeit Holzrahmenbau, Kapitel 11</copyright>
        <version>0.1.0</version>
        <description>Pflichtmerkmale der Bauteilgruppe 'wandelement' im Reifegrad A nach spezifikation/reifegrade.yaml (LOIN nach DIN EN ISO 7817-1:2024-11). Merkmale kumulativ (R erbt P, A erbt R); Granularitätsverbote nur für diesen Reifegrad.</description>
        <author>reifegrade@example.org</author>
        <date>2026-09-27</date>
        <purpose>Bestellung, Werkplanung, Fertigung, Montage, Ausbau</purpose>
        <milestone>unterschriebene Ausstattungsfestlegung (Montage frühestens 12 Wochen danach, regnauerBLB2024), Werkplanung</milestone>
    </info>
    <specifications>
        <specification name="WAND-P-01 Wand: Außen/Innen und Material für die Darstellung" ifcVersion="IFC4X3_ADD2" identifier="WAND-P-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                </property>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="WAND-R-01 Wand: Tragwirkung, DIN-276-Klassifikation, Mengen" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <classification cardinality="required">
                    <value>
                        <xs:restriction base="xs:string">
                            <xs:pattern value="3[34][0-9]" />
                        </xs:restriction>
                    </value>
                    <system>
                        <simpleValue>DIN 276</simpleValue>
                    </system>
                </classification>
                <property dataType="IFCBOOLEAN" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>LoadBearing</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Length</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Height</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Width</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCAREAMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NetSideArea</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-R-02 Außenwand: U-Wert eingetragen (Grenzwert im Profil, z. B. HRB-01)" ifcVersion="IFC4X3_ADD2" identifier="WAND-R-02">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
                <property dataType="IFCBOOLEAN">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>IsExternal</simpleValue>
                    </baseName>
                    <value>
                        <simpleValue>TRUE</simpleValue>
                    </value>
                </property>
            </applicability>
            <requirements>
                <property dataType="IFCTHERMALTRANSMITTANCEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Pset_WallCommon</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>ThermalTransmittance</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="0" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-A-01 Wandelement: Gewicht und Montagenummer (ANF-08-12, B18)" ifcVersion="IFC4X3_ADD2" identifier="WAND-A-01">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCWALL</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <property dataType="IFCMASSMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_WallBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>GrossWeight</simpleValue>
                    </baseName>
                    <value>
                        <xs:restriction base="xs:double">
                            <xs:minExclusive value="0" fixed="false" />
                        </xs:restriction>
                    </value>
                </property>
                <property dataType="IFCINTEGER" cardinality="required">
                    <propertySet>
                        <simpleValue>HRB_Montage</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Montagenummer</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-A-02 Teile eines Wandelements: Material zugeordnet" ifcVersion="IFC4X3_ADD2" identifier="WAND-A-02">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <xs:restriction base="xs:string">
                            <xs:enumeration value="IFCMEMBER" />
                            <xs:enumeration value="IFCPLATE" />
                            <xs:enumeration value="IFCBUILDINGELEMENTPART" />
                        </xs:restriction>
                    </name>
                </entity>
                <partOf relation="IFCRELAGGREGATES">
                    <entity>
                        <name>
                            <simpleValue>IFCWALL</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </applicability>
            <requirements>
                <material cardinality="required" />
            </requirements>
        </specification>
        <specification name="WAND-A-03 Hölzer eines Wandelements: Länge und Nettovolumen" ifcVersion="IFC4X3_ADD2" identifier="WAND-A-03">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCMEMBER</simpleValue>
                    </name>
                </entity>
                <partOf relation="IFCRELAGGREGATES">
                    <entity>
                        <name>
                            <simpleValue>IFCWALL</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </applicability>
            <requirements>
                <property dataType="IFCLENGTHMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_MemberBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>Length</simpleValue>
                    </baseName>
                </property>
                <property dataType="IFCVOLUMEMEASURE" cardinality="required">
                    <propertySet>
                        <simpleValue>Qto_MemberBaseQuantities</simpleValue>
                    </propertySet>
                    <baseName>
                        <simpleValue>NetVolume</simpleValue>
                    </baseName>
                </property>
            </requirements>
        </specification>
        <specification name="WAND-A-04 Verbindungsmitteltyp: Nenndurchmesser und Nennlänge" ifcVersion="IFC4X3_ADD2" identifier="WAND-A-04">
            <applicability minOccurs="1" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCMECHANICALFASTENERTYPE</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>NominalDiameter</simpleValue>
                    </name>
                </attribute>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>NominalLength</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
        <specification name="WAND-A-05 Verbindungsmittel: Teil eines Wandelements" ifcVersion="IFC4X3_ADD2" identifier="WAND-A-05">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCMECHANICALFASTENER</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <partOf relation="IFCRELAGGREGATES" cardinality="required">
                    <entity>
                        <name>
                            <simpleValue>IFCWALL</simpleValue>
                        </name>
                    </entity>
                </partOf>
            </requirements>
        </specification>
    </specifications>
</ids>